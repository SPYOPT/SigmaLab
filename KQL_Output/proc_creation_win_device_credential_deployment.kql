// Regla Sigma: proc_creation_win_device_credential_deployment.yml
// ID Sigma: b8b1b304-a60f-4999-9a6e-c547bde03ffd
// Título: DeviceCredentialDeployment Execution
// Descripción: Detects the execution of DeviceCredentialDeployment to hide a process from view.

// Fecha de creación: 2022-08-19
// Fecha de modificación: 
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_device_credential_deployment.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where FolderPath endswith "\\DeviceCredentialDeployment.exe"
