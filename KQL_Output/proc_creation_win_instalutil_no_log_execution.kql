// Regla Sigma: proc_creation_win_instalutil_no_log_execution.yml
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_instalutil_no_log_execution.yml
// Pipeline: microsoft_xdr
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where FolderPath endswith "\\InstallUtil.exe" and FolderPath contains "Microsoft.NET\\Framework" and (ProcessCommandLine contains "/logfile= " and ProcessCommandLine contains "/LogToConsole=false")
