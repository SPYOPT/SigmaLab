// Regla Sigma: proc_creation_win_powershell_susp_ps_appdata.yml
// ID Sigma: ac175779-025a-4f12-98b0-acdaeb77ea85
// Título: PowerShell Script Run in AppData
// Descripción: Detects a suspicious command line execution that invokes PowerShell with reference to an AppData folder
// Fecha de creación: 2019-01-09
// Fecha de modificación: 2022-07-14
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_powershell_susp_ps_appdata.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (ProcessCommandLine contains "powershell.exe" or ProcessCommandLine contains "\\powershell" or ProcessCommandLine contains "\\pwsh" or ProcessCommandLine contains "pwsh.exe") and ((ProcessCommandLine contains "/c " and ProcessCommandLine contains "\\AppData\\") and (ProcessCommandLine contains "Local\\" or ProcessCommandLine contains "Roaming\\"))
