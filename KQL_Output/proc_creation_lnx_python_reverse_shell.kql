// Regla Sigma: proc_creation_lnx_python_reverse_shell.yml
// ID Sigma: 32e62bc7-3de0-4bb1-90af-532978fe42c0
// Título: Python Reverse Shell Execution Via PTY And Socket Modules
// Descripción: Detects the execution of python with calls to the socket and pty module in order to connect and spawn a potential reverse shell.

// Fecha de creación: 2023-04-24
// Fecha de modificación: 2024-11-04
// Aplica a: Producto: linux | Categoría: process_creation
// Producto: linux
// Categoría: process_creation
// Servicio: 
// Nivel: high
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\linux\process_creation\proc_creation_lnx_python_reverse_shell.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where FolderPath contains "python" and (ProcessCommandLine contains " -c " and ProcessCommandLine contains "import" and ProcessCommandLine contains "pty" and ProcessCommandLine contains "socket" and ProcessCommandLine contains "spawn" and ProcessCommandLine contains ".connect")
