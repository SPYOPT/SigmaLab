// Regla Sigma: proc_creation_win_desktopimgdownldr_remote_file_download.yml
// ID Sigma: 214641c2-c579-4ecb-8427-0cf19df6842e
// Título: Remote File Download Via Desktopimgdownldr Utility
// Descripción: Detects the desktopimgdownldr utility being used to download a remote file. An adversary may use desktopimgdownldr to download arbitrary files as an alternative to certutil.
// Fecha de creación: 2022-09-27
// Fecha de modificación: 
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_desktopimgdownldr_remote_file_download.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where FolderPath endswith "\\desktopimgdownldr.exe" and InitiatingProcessFolderPath endswith "\\desktopimgdownldr.exe" and ProcessCommandLine contains "/lockscreenurl:http"
