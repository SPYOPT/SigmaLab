// Regla Sigma: proc_creation_win_hktl_invoke_obfuscation_via_use_mhsta.yml
// ID Sigma: ac20ae82-8758-4f38-958e-b44a3140ca88
// Título: Invoke-Obfuscation Via Use MSHTA
// Descripción: Detects Obfuscated Powershell via use MSHTA in Scripts
// Fecha de creación: 2020-10-08
// Fecha de modificación: 2022-03-08
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: high
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_hktl_invoke_obfuscation_via_use_mhsta.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where ProcessCommandLine contains "set" and ProcessCommandLine contains "&&" and ProcessCommandLine contains "mshta" and ProcessCommandLine contains "vbscript:createobject" and ProcessCommandLine contains ".run" and ProcessCommandLine contains "(window.close)"
