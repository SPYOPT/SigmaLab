// Regla Sigma: proc_creation_macos_remote_access_tools_teamviewer_incoming_connection.yml
// ID Sigma: f459ccb4-9805-41ea-b5b2-55e279e2424a
// Título: Remote Access Tool - Team Viewer Session Started On MacOS Host
// Descripción: Detects the command line executed when TeamViewer starts a session started by a remote host.
Once a connection has been started, an investigator can verify the connection details by viewing the "incoming_connections.txt" log file in the TeamViewer folder.

// Fecha de creación: 2024-03-11
// Fecha de modificación: 
// Aplica a: Producto: macos | Categoría: process_creation
// Producto: macos
// Categoría: process_creation
// Servicio: 
// Nivel: low
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\macos\process_creation\proc_creation_macos_remote_access_tools_teamviewer_incoming_connection.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where InitiatingProcessFolderPath endswith "/TeamViewer_Service" and FolderPath endswith "/TeamViewer_Desktop" and ProcessCommandLine endswith "/TeamViewer_Desktop --IPCport 5939 --Module 1"
