# ==================================================
.venv/
venv/
env/
ENV/

# ==================================================
# CACHÉ Y ARCHIVOS GENERADOS POR PYTHON
# ==================================================
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ==================================================
# EJECUTABLES Y BINARIOS
# Evita subir sigma.exe y otros archivos bloqueados
# ==================================================
*.exe
*.dll
*.pyd
*.so

# ==================================================
# REPOSITORIOS EXTERNOS CLONADOS
# Tu solución utiliza estos proyectos, pero no debes
# volver a publicarlos dentro de tu repositorio
# ==================================================
sigma/
pySigma/
Sigma2KQL/

