// Regla Sigma: proc_creation_win_reg_add_run_key.yml
// ID Sigma: de587dce-915e-4218-aac4-835ca6af6f70
// Título: Potential Persistence Attempt Via Run Keys Using Reg.EXE
// Descripción: Detects suspicious command line reg.exe tool adding key to RUN key in Registry
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_reg_add_run_key.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where FolderPath endswith "\\reg.exe" and (ProcessCommandLine contains "reg" and ProcessCommandLine contains " add ") and (ProcessCommandLine contains "Software\\Microsoft\\Windows\\CurrentVersion\\Run" or ProcessCommandLine contains "\\Software\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\Run" or ProcessCommandLine contains "\\Software\\Microsoft\\Windows\\CurrentVersion\\Policies\\Explorer\\Run")
