// Regla Sigma: proc_creation_win_net_use_mount_internet_share.yml
// ID Sigma: 7e6237fe-3ddb-438f-9381-9bf9de5af8d0
// Título: Windows Internet Hosted WebDav Share Mount Via Net.EXE
// Descripción: Detects when an internet hosted webdav share is mounted using the "net.exe" utility
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: high
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_net_use_mount_internet_share.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where ((FolderPath endswith "\\net.exe" or FolderPath endswith "\\net1.exe") or (ProcessVersionInfoOriginalFileName in~ ("net.exe", "net1.exe"))) and (ProcessCommandLine contains " use " and ProcessCommandLine contains " http")
