// Regla Sigma: proc_creation_win_cmd_net_use_and_exec_combo.yml
// ID Sigma: f0507c0f-a3a2-40f5-acc6-7f543c334993
// Título: Suspicious File Execution From Internet Hosted WebDav Share
// Descripción: Detects the execution of the "net use" command to mount a WebDAV server and then immediately execute some content in it. As seen being used in malicious LNK files
// Fecha de creación: 2022-09-01
// Fecha de modificación: 2023-02-21
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: high
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_cmd_net_use_and_exec_combo.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (FolderPath contains "\\cmd.exe" or ProcessVersionInfoOriginalFileName =~ "Cmd.EXE") and (ProcessCommandLine contains " net use http" and ProcessCommandLine contains "& start /b " and ProcessCommandLine contains "\\DavWWWRoot\\") and (ProcessCommandLine contains ".exe " or ProcessCommandLine contains ".dll " or ProcessCommandLine contains ".bat " or ProcessCommandLine contains ".vbs " or ProcessCommandLine contains ".ps1 ")
