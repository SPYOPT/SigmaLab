// Regla Sigma: proc_creation_win_dsacls_password_spray.yml
// ID Sigma: bac9fb54-2da7-44e9-988f-11e9a5edbc0c
// Título: Potential Password Spraying Attempt Using Dsacls.EXE
// Descripción: Detects possible password spraying attempts using Dsacls
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_dsacls_password_spray.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (FolderPath endswith "\\dsacls.exe" or ProcessVersionInfoOriginalFileName =~ "DSACLS.EXE") and (ProcessCommandLine contains "/user:" and ProcessCommandLine contains "/passwd:")
