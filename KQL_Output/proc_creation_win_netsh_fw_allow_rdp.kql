// Regla Sigma: proc_creation_win_netsh_fw_allow_rdp.yml
// ID Sigma: 01aeb693-138d-49d2-9403-c4f52d7d3d62
// Título: RDP Connection Allowed Via Netsh.EXE
// Descripción: Detects usage of the netsh command to open and allow connections to port 3389 (RDP). As seen used by Sarwent Malware
// Fecha de creación: 2020-05-23
// Fecha de modificación: 2023-12-11
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: high
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_netsh_fw_allow_rdp.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (FolderPath endswith "\\netsh.exe" or ProcessVersionInfoOriginalFileName =~ "netsh.exe") and ((ProcessCommandLine contains "firewall " and ProcessCommandLine contains "add " and ProcessCommandLine contains "tcp " and ProcessCommandLine contains "3389") and (ProcessCommandLine contains "portopening" or ProcessCommandLine contains "allow"))
