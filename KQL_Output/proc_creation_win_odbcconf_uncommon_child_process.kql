// Regla Sigma: proc_creation_win_odbcconf_uncommon_child_process.yml
// ID Sigma: 8e3c7994-131e-4ba5-b6ea-804d49113a26
// Título: Uncommon Child Process Spawned By Odbcconf.EXE
// Descripción: Detects an uncommon child process of "odbcconf.exe" binary which normally shouldn't have any child processes.
// Fecha de creación: 2023-05-22
// Fecha de modificación: 
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_odbcconf_uncommon_child_process.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where InitiatingProcessFolderPath endswith "\\odbcconf.exe"
