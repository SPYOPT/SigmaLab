// Regla Sigma: proc_creation_win_iis_susp_module_registration.yml
// ID Sigma: 043c4b8b-3a54-4780-9682-081cb6b8185c
// Título: Suspicious IIS Module Registration
// Descripción: Detects a suspicious IIS module registration as described in Microsoft threat report on IIS backdoors
// Fecha de creación: 2022-08-04
// Fecha de modificación: 2023-01-23
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: high
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_iis_susp_module_registration.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where InitiatingProcessFolderPath endswith "\\w3wp.exe" and (ProcessCommandLine contains "appcmd.exe add module" or (ProcessCommandLine contains " system.enterpriseservices.internal.publish" and FolderPath endswith "\\powershell.exe") or (ProcessCommandLine contains "gacutil" and ProcessCommandLine contains " /I"))
