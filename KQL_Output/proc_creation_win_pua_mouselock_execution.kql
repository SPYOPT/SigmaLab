// Regla Sigma: proc_creation_win_pua_mouselock_execution.yml
// ID Sigma: c9192ad9-75e5-43eb-8647-82a0a5b493e3
// Título: PUA - Mouse Lock Execution
// Descripción: In Kaspersky's 2020 Incident Response Analyst Report they listed legitimate tool "Mouse Lock" as being used for both credential access and collection in security incidents.
// Fecha de creación: 2020-08-13
// Fecha de modificación: 2023-02-21
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_pua_mouselock_execution.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where ProcessVersionInfoProductName contains "Mouse Lock" or ProcessVersionInfoCompanyName contains "Misc314" or ProcessCommandLine contains "Mouse Lock_"
