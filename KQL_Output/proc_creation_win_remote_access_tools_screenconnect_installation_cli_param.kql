// Regla Sigma: proc_creation_win_remote_access_tools_screenconnect_installation_cli_param.yml
// ID Sigma: 75bfe6e6-cd8e-429e-91d3-03921e1d7962
// Título: Remote Access Tool - ScreenConnect Installation Execution
// Descripción: Detects ScreenConnect program starts that establish a remote access to a system.
// Fecha de creación: 2021-02-11
// Fecha de modificación: 2024-02-26
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_remote_access_tools_screenconnect_installation_cli_param.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where ProcessCommandLine contains "e=Access&" and ProcessCommandLine contains "y=Guest&" and ProcessCommandLine contains "&p=" and ProcessCommandLine contains "&c=" and ProcessCommandLine contains "&k="
