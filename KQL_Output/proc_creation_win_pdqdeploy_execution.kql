// Regla Sigma: proc_creation_win_pdqdeploy_execution.yml
// ID Sigma: d679950c-abb7-43a6-80fb-2a480c4fc450
// Título: PDQ Deploy Remote Adminstartion Tool Execution
// Descripción: Detect use of PDQ Deploy remote admin tool
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_pdqdeploy_execution.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where ProcessVersionInfoFileDescription =~ "PDQ Deploy Console" or ProcessVersionInfoProductName =~ "PDQ Deploy" or ProcessVersionInfoCompanyName =~ "PDQ.com" or ProcessVersionInfoOriginalFileName =~ "PDQDeployConsole.exe"
