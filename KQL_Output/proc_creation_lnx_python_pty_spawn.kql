// Regla Sigma: proc_creation_lnx_python_pty_spawn.yml
// ID Sigma: c4042d54-110d-45dd-a0e1-05c47822c937
// Título: Python Spawning Pretty TTY Via PTY Module
// Descripción: Detects a python process calling to the PTY module in order to spawn a pretty tty which could be indicative of potential reverse shell activity.

// Aplica a: Producto: linux | Categoría: process_creation
// Producto: linux
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\linux\process_creation\proc_creation_lnx_python_pty_spawn.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where ((FolderPath endswith "/python" or FolderPath endswith "/python2" or FolderPath endswith "/python3") or (FolderPath contains "/python2." or FolderPath contains "/python3.")) and (ProcessCommandLine contains "import pty" or ProcessCommandLine contains "from pty ") and ProcessCommandLine contains "spawn"
