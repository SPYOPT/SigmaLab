// Fecha de creación: 2022-07-05
// Fecha de modificación: 
// Aplica a: Producto: linux | Categoría: process_creation
// Producto: linux
// Categoría: process_creation
// Servicio: 
// Nivel: high
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\linux\process_creation\proc_creation_lnx_triple_cross_rootkit_execve_hijack.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where FolderPath endswith "/sudo" and ProcessCommandLine contains "execve_hijack"
