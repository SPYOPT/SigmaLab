// Regla Sigma: proc_creation_win_remote_access_tools_tacticalrmm_agent_registration_via_cli.yml
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_remote_access_tools_tacticalrmm_agent_registration_via_cli.yml
// Pipeline: microsoft_xdr
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where FolderPath contains "\\TacticalAgent\\tacticalrmm.exe" and (ProcessCommandLine contains "--api" and ProcessCommandLine contains "--auth" and ProcessCommandLine contains "--client-id" and ProcessCommandLine contains "--site-id" and ProcessCommandLine contains "--agent-type")
