// Regla Sigma: proc_creation_win_wbadmin_delete_all_backups.yml
// ID Sigma: 639c9081-f482-47d3-a0bd-ddee3d4ecd76
// Título: All Backups Deleted Via Wbadmin.EXE
// Descripción: Detects the deletion of all backups or system state backups via "wbadmin.exe".
This technique is used by numerous ransomware families and actors.
This may only be successful on server platforms that have Windows Backup enabled.

// Fecha de creación: 2021-12-13
// Fecha de modificación: 2024-05-10
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: high
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_wbadmin_delete_all_backups.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (FolderPath endswith "\\wbadmin.exe" or ProcessVersionInfoOriginalFileName =~ "WBADMIN.EXE") and ((ProcessCommandLine contains "delete" and ProcessCommandLine contains "backup") and ProcessCommandLine contains "keepVersions:0")
