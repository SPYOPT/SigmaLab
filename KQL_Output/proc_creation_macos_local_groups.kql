// Regla Sigma: proc_creation_macos_local_groups.yml
// ID Sigma: 89bb1f97-c7b9-40e8-b52b-7d6afbd67276
// Título: Local Groups Discovery - MacOs
// Descripción: Detects enumeration of local system groups
// Fecha de creación: 2020-10-11
// Fecha de modificación: 2022-11-27
// Aplica a: Producto: macos | Categoría: process_creation
// Producto: macos
// Categoría: process_creation
// Servicio: 
// Nivel: informational
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\macos\process_creation\proc_creation_macos_local_groups.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (FolderPath endswith "/dscacheutil" and (ProcessCommandLine contains "-q" and ProcessCommandLine contains "group")) or (FolderPath endswith "/cat" and ProcessCommandLine contains "/etc/group") or (FolderPath endswith "/dscl" and (ProcessCommandLine contains "-list" and ProcessCommandLine contains "/groups"))
