// Regla Sigma: proc_creation_win_powershell_kerberos_kerberos_ticket_request_via_cli.yml
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_powershell_kerberos_kerberos_ticket_request_via_cli.yml
// Pipeline: microsoft_xdr
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where ((FolderPath endswith "\\powershell.exe" or FolderPath endswith "\\pwsh.exe") or (ProcessVersionInfoOriginalFileName in~ ("powershell.exe", "pwsh.dll"))) and ProcessCommandLine contains "System.IdentityModel.Tokens.KerberosRequestorSecurityToken"
