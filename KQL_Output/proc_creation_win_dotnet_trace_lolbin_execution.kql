// Regla Sigma: proc_creation_win_dotnet_trace_lolbin_execution.yml
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_dotnet_trace_lolbin_execution.yml
// Pipeline: microsoft_xdr
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (FolderPath endswith "\\dotnet-trace.exe" or ProcessVersionInfoOriginalFileName =~ "dotnet-trace.dll") and (ProcessCommandLine contains "-- " and ProcessCommandLine contains "collect")
