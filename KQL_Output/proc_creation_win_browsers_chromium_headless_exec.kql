// Regla Sigma: proc_creation_win_browsers_chromium_headless_exec.yml
// ID Sigma: ef9dcfed-690c-4c5d-a9d1-482cd422225c
// Título: Browser Execution In Headless Mode
// Descripción: Detects execution of Chromium based browser in headless mode
// Fecha de creación: 2023-09-12
// Fecha de modificación: 
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: low
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_browsers_chromium_headless_exec.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (FolderPath endswith "\\brave.exe" or FolderPath endswith "\\chrome.exe" or FolderPath endswith "\\msedge.exe" or FolderPath endswith "\\opera.exe" or FolderPath endswith "\\vivaldi.exe") and ProcessCommandLine contains "--headless"
