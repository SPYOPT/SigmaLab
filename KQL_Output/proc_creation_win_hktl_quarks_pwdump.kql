// Regla Sigma: proc_creation_win_hktl_quarks_pwdump.yml
// ID Sigma: 0685b176-c816-4837-8e7b-1216f346636b
// Título: HackTool - Quarks PwDump Execution
// Descripción: Detects usage of the Quarks PwDump tool via commandline arguments
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: high
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_hktl_quarks_pwdump.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where FolderPath endswith "\\QuarksPwDump.exe" or (ProcessCommandLine in~ (" -dhl", " --dump-hash-local", " -dhdc", " --dump-hash-domain-cached", " --dump-bitlocker", " -dhd ", " --dump-hash-domain ", "--ntds-file"))
