// Regla Sigma: proc_creation_lnx_git_shell_execution.yml
// ID Sigma: 47b3bbd4-1bf7-48cc-84ab-995362aaa75a
// Título: Shell Execution via Git - Linux
// Descripción: Detects the use of the "git" utility to execute a shell. Such behavior may be associated with privilege escalation, unauthorized command execution, or to break out from restricted environments.

// Aplica a: Producto: linux | Categoría: process_creation
// Producto: linux
// Categoría: process_creation
// Servicio: 
// Nivel: high
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\linux\process_creation\proc_creation_lnx_git_shell_execution.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where InitiatingProcessFolderPath endswith "/git" and (InitiatingProcessCommandLine contains " -p " and InitiatingProcessCommandLine contains "help") and (ProcessCommandLine contains "bash 0<&1" or ProcessCommandLine contains "dash 0<&1" or ProcessCommandLine contains "sh 0<&1")
