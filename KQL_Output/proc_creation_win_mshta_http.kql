// Regla Sigma: proc_creation_win_mshta_http.yml
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_mshta_http.yml
// Pipeline: microsoft_xdr
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (FolderPath endswith "\\mshta.exe" or ProcessVersionInfoOriginalFileName =~ "MSHTA.EXE") and (ProcessCommandLine contains "http://" or ProcessCommandLine contains "https://" or ProcessCommandLine contains "ftp://")
