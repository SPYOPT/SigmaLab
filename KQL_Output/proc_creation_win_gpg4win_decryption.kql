// Regla Sigma: proc_creation_win_gpg4win_decryption.yml
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_gpg4win_decryption.yml
// Pipeline: microsoft_xdr
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where ((FolderPath endswith "\\gpg.exe" or FolderPath endswith "\\gpg2.exe") or ProcessVersionInfoFileDescription =~ "GnuPG’s OpenPGP tool") and (ProcessCommandLine contains " -d " and ProcessCommandLine contains "passphrase")
