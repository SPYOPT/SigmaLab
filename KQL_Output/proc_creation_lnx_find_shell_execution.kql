// Regla Sigma: proc_creation_lnx_find_shell_execution.yml
// ID Sigma: 6adfbf8f-52be-4444-9bac-81b539624146
// Título: Shell Execution via Find - Linux
// Descripción: Detects the use of the find command to execute a shell. Such behavior may be associated with privilege escalation, unauthorized command execution, or exploitation attempt.

// Aplica a: Producto: linux | Categoría: process_creation
// Producto: linux
// Categoría: process_creation
// Servicio: 
// Nivel: high
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\linux\process_creation\proc_creation_lnx_find_shell_execution.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (FolderPath endswith "/find" and (ProcessCommandLine contains " . " and ProcessCommandLine contains "-exec")) and (ProcessCommandLine contains "/bin/bash" or ProcessCommandLine contains "/bin/dash" or ProcessCommandLine contains "/bin/fish" or ProcessCommandLine contains "/bin/sh" or ProcessCommandLine contains "/bin/zsh")
