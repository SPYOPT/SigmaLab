// Regla Sigma: proc_creation_win_dtrace_kernel_dump.yml
// ID Sigma: 7124aebe-4cd7-4ccb-8df0-6d6b93c96795
// Título: Suspicious Kernel Dump Using Dtrace
// Descripción: Detects suspicious way to dump the kernel on Windows systems using dtrace.exe, which is available on Windows systems since Windows 10 19H1
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: high
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_dtrace_kernel_dump.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (FolderPath endswith "\\dtrace.exe" and ProcessCommandLine contains "lkd(0)") or (ProcessCommandLine contains "syscall:::return" and ProcessCommandLine contains "lkd(")
