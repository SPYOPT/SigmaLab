// Regla Sigma: proc_creation_win_vscode_tunnel_service_install.yml
// ID Sigma: 30bf1789-379d-4fdc-900f-55cd0a90a801
// Título: Visual Studio Code Tunnel Service Installation
// Descripción: Detects the installation of VsCode tunnel (code-tunnel) as a service.
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_vscode_tunnel_service_install.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where ProcessCommandLine contains "tunnel " and ProcessCommandLine contains "service" and ProcessCommandLine contains "internal-run" and ProcessCommandLine contains "tunnel-service.log"
