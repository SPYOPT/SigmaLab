// Regla Sigma: proc_creation_win_lolbin_susp_driver_installed_by_pnputil.yml
// ID Sigma: a2ea3ae7-d3d0-40a0-a55c-25a45c87cac1
// Título: Suspicious Driver Install by pnputil.exe
// Descripción: Detects when a possible suspicious driver is being installed via pnputil.exe lolbin
// Fecha de creación: 2021-09-30
// Fecha de modificación: 2022-10-09
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_lolbin_susp_driver_installed_by_pnputil.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (ProcessCommandLine contains "-i" or ProcessCommandLine contains "/install" or ProcessCommandLine contains "-a" or ProcessCommandLine contains "/add-driver" or ProcessCommandLine contains ".inf") and FolderPath endswith "\\pnputil.exe"
