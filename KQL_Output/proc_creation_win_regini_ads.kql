// Regla Sigma: proc_creation_win_regini_ads.yml
// ID Sigma: 77946e79-97f1-45a2-84b4-f37b5c0d8682
// Título: Suspicious Registry Modification From ADS Via Regini.EXE
// Descripción: Detects the import of an alternate data stream with regini.exe, regini.exe can be used to modify registry keys.
// Fecha de creación: 2020-10-12
// Fecha de modificación: 2023-02-08
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: high
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_regini_ads.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (FolderPath endswith "\\regini.exe" or ProcessVersionInfoOriginalFileName =~ "REGINI.EXE") and ProcessCommandLine matches regex ":[^ \\\\]"
