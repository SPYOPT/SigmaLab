// Regla Sigma: proc_creation_win_winrm_execution_via_scripting_api_winrm_vbs.yml
// ID Sigma: 9df0dd3a-1a5c-47e3-a2bc-30ed177646a0
// Título: Remote Code Execute via Winrm.vbs
// Descripción: Detects an attempt to execute code or create service on remote host via winrm.vbs.
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_winrm_execution_via_scripting_api_winrm_vbs.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (FolderPath endswith "\\cscript.exe" or ProcessVersionInfoOriginalFileName =~ "cscript.exe") and (ProcessCommandLine contains "winrm" and ProcessCommandLine contains "invoke Create wmicimv2/Win32_" and ProcessCommandLine contains "-r:http")
