// Regla Sigma: proc_creation_win_dotnet_trace_lolbin_execution.yml
// ID Sigma: 9257c05b-4a4a-48e5-a670-b7b073cf401b
// Título: Binary Proxy Execution Via Dotnet-Trace.EXE
// Descripción: Detects commandline arguments for executing a child process via dotnet-trace.exe
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_dotnet_trace_lolbin_execution.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (FolderPath endswith "\\dotnet-trace.exe" or ProcessVersionInfoOriginalFileName =~ "dotnet-trace.dll") and (ProcessCommandLine contains "-- " and ProcessCommandLine contains "collect")
