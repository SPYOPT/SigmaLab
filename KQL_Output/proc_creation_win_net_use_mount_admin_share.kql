// Regla Sigma: proc_creation_win_net_use_mount_admin_share.yml
// ID Sigma: 3abd6094-7027-475f-9630-8ab9be7b9725
// Título: Windows Admin Share Mount Via Net.EXE
// Descripción: Detects when an admin share is mounted using net.exe
// Fecha de creación: 2020-10-05
// Fecha de modificación: 2023-02-21
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_net_use_mount_admin_share.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where ((FolderPath endswith "\\net.exe" or FolderPath endswith "\\net1.exe") or (ProcessVersionInfoOriginalFileName in~ ("net.exe", "net1.exe"))) and (ProcessCommandLine contains " use " and (ProcessCommandLine contains " \\" and ProcessCommandLine contains "\\" and ProcessCommandLine contains "$"))
