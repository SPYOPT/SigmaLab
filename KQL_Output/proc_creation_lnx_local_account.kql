// Regla Sigma: proc_creation_lnx_local_account.yml
// ID Sigma: b45e3d6f-42c6-47d8-a478-df6bd6cf534c
// Título: Local System Accounts Discovery - Linux
// Descripción: Detects enumeration of local system accounts. This information can help adversaries determine which local accounts exist on a system to aid in follow-on behavior.
// Fecha de creación: 2020-10-08
// Fecha de modificación: 2024-12-10
// Aplica a: Producto: linux | Categoría: process_creation
// Producto: linux
// Categoría: process_creation
// Servicio: 
// Nivel: low
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\linux\process_creation\proc_creation_lnx_local_account.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where FolderPath endswith "/lastlog" or ProcessCommandLine contains "'x:0:'" or ((FolderPath endswith "/cat" or FolderPath endswith "/ed" or FolderPath endswith "/head" or FolderPath endswith "/more" or FolderPath endswith "/nano" or FolderPath endswith "/tail" or FolderPath endswith "/vi" or FolderPath endswith "/vim" or FolderPath endswith "/less" or FolderPath endswith "/emacs" or FolderPath endswith "/sqlite3" or FolderPath endswith "/makemap") and (ProcessCommandLine contains "/etc/passwd" or ProcessCommandLine contains "/etc/shadow" or ProcessCommandLine contains "/etc/sudoers" or ProcessCommandLine contains "/etc/spwd.db" or ProcessCommandLine contains "/etc/pwd.db" or ProcessCommandLine contains "/etc/master.passwd")) or FolderPath endswith "/id" or (FolderPath endswith "/lsof" and ProcessCommandLine contains "-u")
