// Regla Sigma: proc_creation_win_rundll32_user32_dll.yml
// ID Sigma: 3b5b0213-0460-4e3f-8937-3abf98ff7dcc
// Título: Suspicious Workstation Locking via Rundll32
// Descripción: Detects a suspicious call to the user32.dll function that locks the user workstation
// Fecha de creación: 2022-06-04
// Fecha de modificación: 2023-02-09
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_rundll32_user32_dll.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (FolderPath endswith "\\rundll32.exe" or ProcessVersionInfoOriginalFileName =~ "RUNDLL32.EXE") and InitiatingProcessFolderPath endswith "\\cmd.exe" and ProcessCommandLine contains "user32.dll," and ProcessCommandLine contains "LockWorkStation"
