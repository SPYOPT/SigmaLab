// Regla Sigma: proc_creation_win_net_use_mount_internet_share.yml
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_net_use_mount_internet_share.yml
// Pipeline: microsoft_xdr
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where ((FolderPath endswith "\\net.exe" or FolderPath endswith "\\net1.exe") or (ProcessVersionInfoOriginalFileName in~ ("net.exe", "net1.exe"))) and (ProcessCommandLine contains " use " and ProcessCommandLine contains " http")
