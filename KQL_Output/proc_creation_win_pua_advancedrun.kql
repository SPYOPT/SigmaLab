// Regla Sigma: proc_creation_win_pua_advancedrun.yml
// ID Sigma: d2b749ee-4225-417e-b20e-a8d2193cbb84
// Título: PUA - AdvancedRun Execution
// Descripción: Detects the execution of AdvancedRun utility
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_pua_advancedrun.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where ProcessVersionInfoOriginalFileName =~ "AdvancedRun.exe" or (ProcessCommandLine contains " /EXEFilename " and ProcessCommandLine contains " /Run") or (ProcessCommandLine contains " /WindowState 0" and ProcessCommandLine contains " /RunAs " and ProcessCommandLine contains " /CommandLine ")
