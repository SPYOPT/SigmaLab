// Regla Sigma: proc_creation_win_autologger_session_registry_modification.yml
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_autologger_session_registry_modification.yml
// Pipeline: microsoft_xdr
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where ((FolderPath endswith "\\reg.exe" or FolderPath endswith "\\powershell.exe" or FolderPath endswith "\\pwsh.exe") or (ProcessVersionInfoOriginalFileName in~ ("reg.exe", "PowerShell.EXE", "pwsh.dll"))) and (ProcessCommandLine contains "add " or ProcessCommandLine contains "Set-ItemProperty" or ProcessCommandLine contains "New-ItemProperty" or ProcessCommandLine contains "si ") and ProcessCommandLine contains "\\Control\\WMI\\Autologger\\" and (ProcessCommandLine contains "Start" or ProcessCommandLine contains "Enabled")
