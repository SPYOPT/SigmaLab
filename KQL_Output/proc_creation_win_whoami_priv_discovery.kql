// Regla Sigma: proc_creation_win_whoami_priv_discovery.yml
// ID Sigma: 97a80ec7-0e2f-4d05-9ef4-65760e634f6b
// Título: Security Privileges Enumeration Via Whoami.EXE
// Descripción: Detects a whoami.exe executed with the /priv command line flag instructing the tool to show all current user privileges. This is often used after a privilege escalation attempt.
// Fecha de creación: 2021-05-05
// Fecha de modificación: 2023-02-28
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: high
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_whoami_priv_discovery.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (FolderPath endswith "\\whoami.exe" or ProcessVersionInfoOriginalFileName =~ "whoami.exe") and (ProcessCommandLine contains " /priv" or ProcessCommandLine contains " -priv")
