// Regla Sigma: proc_creation_lnx_susp_inod_listing.yml
// ID Sigma: 43e26eb5-cd58-48d1-8ce9-a273f5d298d8
// Título: Potential Container Discovery Via Inodes Listing
// Descripción: Detects listing of the inodes of the "/" directory to determine if the we are running inside of a container.
// Aplica a: Producto: linux | Categoría: process_creation
// Producto: linux
// Categoría: process_creation
// Servicio: 
// Nivel: low
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\linux\process_creation\proc_creation_lnx_susp_inod_listing.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where FolderPath endswith "/ls" and (ProcessCommandLine endswith " /" or ProcessCommandLine contains " / ") and ProcessCommandLine matches regex "(?:\\s-[^-\\s]{0,20}i|\\s--inode\\s)" and ProcessCommandLine matches regex "(?:\\s-[^-\\s]{0,20}d|\\s--directory\\s)"
