// Regla Sigma: proc_creation_win_sqlite_firefox_gecko_profile_data.yml
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_sqlite_firefox_gecko_profile_data.yml
// Pipeline: microsoft_xdr
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (ProcessVersionInfoProductName =~ "SQLite" or (FolderPath endswith "\\sqlite.exe" or FolderPath endswith "\\sqlite3.exe")) and (ProcessCommandLine contains "cookies.sqlite" or ProcessCommandLine contains "places.sqlite")
