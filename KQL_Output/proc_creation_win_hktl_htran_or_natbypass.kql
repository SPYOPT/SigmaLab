// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (FolderPath endswith "\\htran.exe" or FolderPath endswith "\\lcx.exe") or (ProcessCommandLine contains ".exe -tran " or ProcessCommandLine contains ".exe -slave ")
