// Regla Sigma: proc_creation_win_netsh_wifi_credential_harvesting.yml
// ID Sigma: 42b1a5b8-353f-4f10-b256-39de4467faff
// Título: Harvesting Of Wifi Credentials Via Netsh.EXE
// Descripción: Detect the harvesting of wifi credentials using netsh.exe
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_netsh_wifi_credential_harvesting.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (FolderPath endswith "\\netsh.exe" or ProcessVersionInfoOriginalFileName =~ "netsh.exe") and (ProcessCommandLine contains "wlan" and ProcessCommandLine contains " s" and ProcessCommandLine contains " p" and ProcessCommandLine contains " k" and ProcessCommandLine contains "=clear")
