// Regla Sigma: proc_creation_lnx_gcc_shell_execution.yml
// ID Sigma: 9b5de532-a757-4d70-946c-1f3e44f48b4d
// Título: Shell Execution GCC  - Linux
// Descripción: Detects the use of the "gcc" utility to execute a shell. Such behavior may be associated with privilege escalation, unauthorized command execution, or to break out from restricted environments.

// Aplica a: Producto: linux | Categoría: process_creation
// Producto: linux
// Categoría: process_creation
// Servicio: 
// Nivel: high
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\linux\process_creation\proc_creation_lnx_gcc_shell_execution.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where ((FolderPath endswith "/c89" or FolderPath endswith "/c99" or FolderPath endswith "/gcc") and ProcessCommandLine contains "-wrapper") and (ProcessCommandLine contains "/bin/bash,-s" or ProcessCommandLine contains "/bin/dash,-s" or ProcessCommandLine contains "/bin/fish,-s" or ProcessCommandLine contains "/bin/sh,-s" or ProcessCommandLine contains "/bin/zsh,-s")
