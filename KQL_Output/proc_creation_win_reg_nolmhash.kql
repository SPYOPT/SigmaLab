// Regla Sigma: proc_creation_win_reg_nolmhash.yml
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_reg_nolmhash.yml
// Pipeline: microsoft_xdr
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where ProcessCommandLine contains "\\System\\CurrentControlSet\\Control\\Lsa" and ProcessCommandLine contains "NoLMHash" and ProcessCommandLine contains " 0"
