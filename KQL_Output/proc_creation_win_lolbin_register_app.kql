// Regla Sigma: proc_creation_win_lolbin_register_app.yml
// ID Sigma: 1c8774a0-44d4-4db0-91f8-e792359c70bd
// Título: REGISTER_APP.VBS Proxy Execution
// Descripción: Detects the use of a Microsoft signed script 'REGISTER_APP.VBS' to register a VSS/VDS Provider as a COM+ application.
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_lolbin_register_app.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where ProcessCommandLine contains "\\register_app.vbs" and ProcessCommandLine contains "-register"
