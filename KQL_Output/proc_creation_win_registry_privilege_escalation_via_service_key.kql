// Regla Sigma: proc_creation_win_registry_privilege_escalation_via_service_key.yml
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_registry_privilege_escalation_via_service_key.yml
// Pipeline: microsoft_xdr
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (ProcessIntegrityLevel in~ ("Medium", "S-1-16-8192")) and (ProcessCommandLine contains "ControlSet" and ProcessCommandLine contains "services") and (ProcessCommandLine contains "\\ImagePath" or ProcessCommandLine contains "\\FailureCommand" or ProcessCommandLine contains "\\ServiceDll")
