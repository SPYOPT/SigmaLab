// Regla Sigma: proc_creation_win_vshadow_exec.yml
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_vshadow_exec.yml
// Pipeline: microsoft_xdr
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (FolderPath endswith "\\vshadow.exe" or ProcessVersionInfoOriginalFileName =~ "vshadow.exe") and ProcessCommandLine contains "-exec"
