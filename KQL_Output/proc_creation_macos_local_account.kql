// Regla Sigma: proc_creation_macos_local_account.yml
// Ruta original: C:\SigmaLab\sigma\rules\macos\process_creation\proc_creation_macos_local_account.yml
// Pipeline: microsoft_xdr
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (FolderPath endswith "/dscl" and (ProcessCommandLine contains "list" and ProcessCommandLine contains "/users")) or (FolderPath endswith "/dscacheutil" and (ProcessCommandLine contains "-q" and ProcessCommandLine contains "user")) or ProcessCommandLine matches regex ".*'.*:0:'.*" or ((FolderPath endswith "/cat" or FolderPath endswith "/awk" or FolderPath endswith "/grep") and (ProcessCommandLine contains "/etc/passwd" or ProcessCommandLine contains "/etc/sudoers")) or FolderPath endswith "/id" or (FolderPath endswith "/lsof" and ProcessCommandLine contains "-u") or (FolderPath endswith "/who" or FolderPath endswith "/w" or FolderPath endswith "/users" or FolderPath endswith "/last") or (FolderPath endswith "/ls" and (ProcessCommandLine endswith "/Users" or ProcessCommandLine endswith "/Users'" or ProcessCommandLine endswith "/Users\"")) or ((FolderPath endswith "/defaults" or FolderPath endswith "/plutil") and ProcessCommandLine contains "com.apple.loginwindow")
