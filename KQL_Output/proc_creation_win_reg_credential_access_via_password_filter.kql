// Regla Sigma: proc_creation_win_reg_credential_access_via_password_filter.yml
// ID Sigma: b7966f4a-b333-455b-8370-8ca53c229762
// Título: Dropping Of Password Filter DLL
// Descripción: Detects dropping of dll files in system32 that may be used to retrieve user credentials from LSASS
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_reg_credential_access_via_password_filter.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where ProcessCommandLine contains "HKLM\\SYSTEM\\CurrentControlSet\\Control\\Lsa" and ProcessCommandLine contains "scecli\\0" and ProcessCommandLine contains "reg add"
