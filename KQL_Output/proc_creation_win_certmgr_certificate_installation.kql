// Regla Sigma: proc_creation_win_certmgr_certificate_installation.yml
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_certmgr_certificate_installation.yml
// Pipeline: microsoft_xdr
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (FolderPath endswith "\\CertMgr.exe" or ProcessVersionInfoOriginalFileName =~ "CERTMGT.EXE") and (ProcessCommandLine contains "/add" and ProcessCommandLine contains "root")
