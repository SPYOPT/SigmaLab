// Regla Sigma: proc_creation_win_dism_remove.yml
// ID Sigma: 43e32da2-fdd0-4156-90de-50dfd62636f9
// Título: Dism Remove Online Package
// Descripción: Deployment Image Servicing and Management tool. DISM is used to enumerate, install, uninstall, configure, and update features and packages in Windows images
// Fecha de creación: 2022-01-16
// Fecha de modificación: 2022-08-26
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_dism_remove.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (FolderPath endswith "\\DismHost.exe" and (InitiatingProcessCommandLine contains "/Online" and InitiatingProcessCommandLine contains "/Disable-Feature")) or (FolderPath endswith "\\Dism.exe" and (ProcessCommandLine contains "/Online" and ProcessCommandLine contains "/Disable-Feature"))
