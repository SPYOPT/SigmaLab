// Regla Sigma: proc_creation_lnx_susp_shell_script_exec_from_susp_location.yml
// ID Sigma: 30bcce26-51c5-49f2-99c8-7b59e3af36c7
// Título: Execution Of Script Located In Potentially Suspicious Directory
// Descripción: Detects executions of scripts located in potentially suspicious locations such as "/tmp" via a shell such as "bash", "sh", etc.
// Fecha de creación: 2023-06-02
// Fecha de modificación: 
// Aplica a: Producto: linux | Categoría: process_creation
// Producto: linux
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\linux\process_creation\proc_creation_lnx_susp_shell_script_exec_from_susp_location.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (FolderPath endswith "/bash" or FolderPath endswith "/csh" or FolderPath endswith "/dash" or FolderPath endswith "/fish" or FolderPath endswith "/ksh" or FolderPath endswith "/sh" or FolderPath endswith "/zsh") and ProcessCommandLine contains " -c " and ProcessCommandLine contains "/tmp/"
