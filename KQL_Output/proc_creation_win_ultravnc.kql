// Regla Sigma: proc_creation_win_ultravnc.yml
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_ultravnc.yml
// Pipeline: microsoft_xdr
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where ProcessVersionInfoFileDescription =~ "VNCViewer" or ProcessVersionInfoProductName =~ "UltraVNC VNCViewer" or ProcessVersionInfoCompanyName =~ "UltraVNC" or ProcessVersionInfoOriginalFileName =~ "VNCViewer.exe"
