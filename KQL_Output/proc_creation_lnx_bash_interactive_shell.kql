// Regla Sigma: proc_creation_lnx_bash_interactive_shell.yml
// ID Sigma: 6104e693-a7d6-4891-86cb-49a258523559
// Título: Bash Interactive Shell
// Descripción: Detects execution of the bash shell with the interactive flag "-i".
// Aplica a: Producto: linux | Categoría: process_creation
// Producto: linux
// Categoría: process_creation
// Servicio: 
// Nivel: low
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\linux\process_creation\proc_creation_lnx_bash_interactive_shell.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where FolderPath endswith "/bash" and ProcessCommandLine contains " -i "
