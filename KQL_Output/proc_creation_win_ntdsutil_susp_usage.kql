// Regla Sigma: proc_creation_win_ntdsutil_susp_usage.yml
// ID Sigma: a58353df-af43-4753-bad0-cd83ef35eef5
// Título: Suspicious Usage Of Active Directory Diagnostic Tool (ntdsutil.exe)
// Descripción: Detects execution of ntdsutil.exe to perform different actions such as restoring snapshots...etc.
// Fecha de creación: 2022-09-14
// Fecha de modificación: 
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_ntdsutil_susp_usage.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (FolderPath endswith "\\ntdsutil.exe" or ProcessVersionInfoOriginalFileName =~ "ntdsutil.exe") and ((ProcessCommandLine contains "snapshot" and ProcessCommandLine contains "mount ") or (ProcessCommandLine contains "ac" and ProcessCommandLine contains " i" and ProcessCommandLine contains " ntds"))
