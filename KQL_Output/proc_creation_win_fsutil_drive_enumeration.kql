// Regla Sigma: proc_creation_win_fsutil_drive_enumeration.yml
// ID Sigma: 63de06b9-a385-40b5-8b32-73f2b9ef84b6
// Título: Fsutil Drive Enumeration
// Descripción: Attackers may leverage fsutil to enumerated connected drives.
// Fecha de creación: 2022-03-29
// Fecha de modificación: 2022-07-14
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: low
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_fsutil_drive_enumeration.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (FolderPath endswith "\\fsutil.exe" or ProcessVersionInfoOriginalFileName =~ "fsutil.exe") and ProcessCommandLine contains "drives"
