// Regla Sigma: proc_creation_win_net_stop_service.yml
// ID Sigma: 88872991-7445-4a22-90b2-a3adadb0e827
// Título: Stop Windows Service Via Net.EXE
// Descripción: Detects the stopping of a Windows service via the "net" utility.
// Fecha de creación: 2023-03-05
// Fecha de modificación: 
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: low
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_net_stop_service.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where ((ProcessVersionInfoOriginalFileName in~ ("net.exe", "net1.exe")) or (FolderPath endswith "\\net.exe" or FolderPath endswith "\\net1.exe")) and ProcessCommandLine contains " stop "
