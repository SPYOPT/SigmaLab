// Regla Sigma: proc_creation_macos_sysadminctl_enable_guest_account.yml
// ID Sigma: d7329412-13bd-44ba-a072-3387f804a106
// Título: Guest Account Enabled Via Sysadminctl
// Descripción: Detects attempts to enable the guest account using the sysadminctl utility
// Fecha de creación: 2023-02-18
// Fecha de modificación: 
// Aplica a: Producto: macos | Categoría: process_creation
// Producto: macos
// Categoría: process_creation
// Servicio: 
// Nivel: low
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\macos\process_creation\proc_creation_macos_sysadminctl_enable_guest_account.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where FolderPath endswith "/sysadminctl" and (ProcessCommandLine contains " -guestAccount" and ProcessCommandLine contains " on")
