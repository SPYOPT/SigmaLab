// Regla Sigma: proc_creation_macos_persistence_via_plistbuddy.yml
// Ruta original: C:\SigmaLab\sigma\rules\macos\process_creation\proc_creation_macos_persistence_via_plistbuddy.yml
// Pipeline: microsoft_xdr
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where FolderPath endswith "/PlistBuddy" and (ProcessCommandLine contains "RunAtLoad" and ProcessCommandLine contains "true") and (ProcessCommandLine contains "LaunchAgents" or ProcessCommandLine contains "LaunchDaemons")
