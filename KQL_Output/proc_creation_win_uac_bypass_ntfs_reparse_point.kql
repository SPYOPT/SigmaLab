// Regla Sigma: proc_creation_win_uac_bypass_ntfs_reparse_point.yml
// ID Sigma: 39ed3c80-e6a1-431b-9df3-911ac53d08a7
// Título: UAC Bypass Using NTFS Reparse Point - Process
// Descripción: Detects the pattern of UAC Bypass using NTFS reparse point and wusa.exe DLL hijacking (UACMe 36)
// Fecha de creación: 2021-08-30
// Fecha de modificación: 2024-12-01
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: high
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_uac_bypass_ntfs_reparse_point.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (ProcessCommandLine startswith "\"C:\\Windows\\system32\\wusa.exe\"  /quiet C:\\Users\\" and ProcessCommandLine endswith "\\AppData\\Local\\Temp\\update.msu" and (ProcessIntegrityLevel in~ ("High", "System", "S-1-16-16384", "S-1-16-12288"))) or (InitiatingProcessCommandLine =~ "\"C:\\Windows\\system32\\dism.exe\" /online /quiet /norestart /add-package /packagepath:\"C:\\Windows\\system32\\pe386\" /ignorecheck" and (ProcessIntegrityLevel in~ ("High", "System")) and (ProcessCommandLine contains "C:\\Users\\" and ProcessCommandLine contains "\\AppData\\Local\\Temp\\" and ProcessCommandLine contains "\\dismhost.exe {") and FolderPath endswith "\\DismHost.exe")
