// Regla Sigma: proc_creation_win_werfault_reflect_debugger_exec.yml
// ID Sigma: fabfb3a7-3ce1-4445-9c7c-3c27f1051cdd
// Título: Potential ReflectDebugger Content Execution Via WerFault.EXE
// Descripción: Detects execution of "WerFault.exe" with the "-pr" commandline flag that is used to run files stored in the ReflectDebugger key which could be used to store the path to the malware in order to masquerade the execution flow
// Fecha de creación: 2023-06-30
// Fecha de modificación: 
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_werfault_reflect_debugger_exec.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (FolderPath endswith "\\WerFault.exe" or ProcessVersionInfoOriginalFileName =~ "WerFault.exe") and ProcessCommandLine contains " -pr "
