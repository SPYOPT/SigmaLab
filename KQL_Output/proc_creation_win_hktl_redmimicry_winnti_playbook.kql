DeviceProcessEvents
| where (FolderPath endswith "\\rundll32.exe" or FolderPath endswith "\\cmd.exe") and (ProcessCommandLine contains "gthread-3.6.dll" or ProcessCommandLine contains "\\Windows\\Temp\\tmp.bat" or ProcessCommandLine contains "sigcmm-2.4.dll")
