// Regla Sigma: proc_creation_win_csi_execution.yml
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_csi_execution.yml
// Pipeline: microsoft_xdr
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where ((FolderPath endswith "\\csi.exe" or FolderPath endswith "\\rcsi.exe") or (ProcessVersionInfoOriginalFileName in~ ("csi.exe", "rcsi.exe"))) and ProcessVersionInfoCompanyName =~ "Microsoft Corporation"
