// Regla Sigma: proc_creation_lnx_susp_script_interpretor_spawn_credential_scanner.yml
// ID Sigma: f0025a69-e1b7-4dda-a53c-db21fa2d4071
// Título: Script Interpreter Spawning Credential Scanner - Linux
// Descripción: Detects a script interpreter process (like node.js or bun) spawning a known credential scanning tool (e.g., trufflehog, gitleaks).
This behavior is indicative of an attempt to find and steal secrets, as seen in the "Shai-Hulud: The Second Coming" campaign.

// Aplica a: Producto: linux | Categoría: process_creation
// Producto: linux
// Categoría: process_creation
// Servicio: 
// Nivel: high
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\linux\process_creation\proc_creation_lnx_susp_script_interpretor_spawn_credential_scanner.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (InitiatingProcessFolderPath endswith "/node" or InitiatingProcessFolderPath endswith "/bun") and ((FolderPath endswith "/trufflehog" or FolderPath endswith "/gitleaks") or (ProcessCommandLine contains "trufflehog" or ProcessCommandLine contains "gitleaks"))
