// Regla Sigma: proc_creation_win_powershell_disable_ie_features.yml
// ID Sigma: fb50eb7a-5ab1-43ae-bcc9-091818cb8424
// Título: Disabled IE Security Features
// Descripción: Detects command lines that indicate unwanted modifications to registry keys that disable important Internet Explorer security features
// Fecha de creación: 2020-06-19
// Fecha de modificación: 2021-11-27
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: high
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_powershell_disable_ie_features.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (ProcessCommandLine contains " -name IEHarden " and ProcessCommandLine contains " -value 0 ") or (ProcessCommandLine contains " -name DEPOff " and ProcessCommandLine contains " -value 1 ") or (ProcessCommandLine contains " -name DisableFirstRunCustomize " and ProcessCommandLine contains " -value 2 ")
