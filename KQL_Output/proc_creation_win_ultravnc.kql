// Regla Sigma: proc_creation_win_ultravnc.yml
// ID Sigma: 145322e4-0fd3-486b-81ca-9addc75736d8
// Título: Use of UltraVNC Remote Access Software
// Descripción: An adversary may use legitimate desktop support and remote access software,to establish an interactive command and control channel to target systems within networks
// Fecha de creación: 2022-10-02
// Fecha de modificación: 
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_ultravnc.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where ProcessVersionInfoFileDescription =~ "VNCViewer" or ProcessVersionInfoProductName =~ "UltraVNC VNCViewer" or ProcessVersionInfoCompanyName =~ "UltraVNC" or ProcessVersionInfoOriginalFileName =~ "VNCViewer.exe"
