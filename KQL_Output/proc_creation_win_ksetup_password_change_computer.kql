// Regla Sigma: proc_creation_win_ksetup_password_change_computer.yml
// ID Sigma: de16d92c-c446-4d53-8938-10aeef41c8b6
// Título: Computer Password Change Via Ksetup.EXE
// Descripción: Detects password change for the computer's domain account or host principal via "ksetup.exe"
// Fecha de creación: 2023-04-06
// Fecha de modificación: 
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_ksetup_password_change_computer.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (FolderPath endswith "\\ksetup.exe" or ProcessVersionInfoOriginalFileName =~ "ksetup.exe") and ProcessCommandLine contains " /setcomputerpassword "
