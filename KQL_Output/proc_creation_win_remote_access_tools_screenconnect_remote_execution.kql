// Regla Sigma: proc_creation_win_remote_access_tools_screenconnect_remote_execution.yml
// ID Sigma: b1f73849-6329-4069-bc8f-78a604bb8b23
// Título: Remote Access Tool - ScreenConnect Remote Command Execution
// Descripción: Detects the execution of a system command via the ScreenConnect RMM service.
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: low
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_remote_access_tools_screenconnect_remote_execution.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where InitiatingProcessFolderPath endswith "\\ScreenConnect.ClientService.exe" and (FolderPath endswith "\\cmd.exe" or ProcessVersionInfoOriginalFileName =~ "Cmd.Exe") and ProcessCommandLine contains "\\TEMP\\ScreenConnect\\"
