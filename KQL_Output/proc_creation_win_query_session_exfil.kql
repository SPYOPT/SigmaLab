// Regla Sigma: proc_creation_win_query_session_exfil.yml
// ID Sigma: 53ef0cef-fa24-4f25-a34a-6c72dfa2e6e2
// Título: Query Usage To Exfil Data
// Descripción: Detects usage of "query.exe" a system binary to exfil information such as "sessions" and "processes" for later use
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_query_session_exfil.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where FolderPath endswith ":\\Windows\\System32\\query.exe" and (ProcessCommandLine contains "session >" or ProcessCommandLine contains "process >")
