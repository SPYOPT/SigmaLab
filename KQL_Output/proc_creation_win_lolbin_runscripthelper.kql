// Regla Sigma: proc_creation_win_lolbin_runscripthelper.yml
// ID Sigma: eca49c87-8a75-4f13-9c73-a5a29e845f03
// Título: Suspicious Runscripthelper.exe
// Descripción: Detects execution of powershell scripts via Runscripthelper.exe
// Fecha de creación: 2020-10-09
// Fecha de modificación: 2022-07-11
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_lolbin_runscripthelper.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where FolderPath endswith "\\Runscripthelper.exe" and ProcessCommandLine contains "surfacecheck"
