// Regla Sigma: proc_creation_win_hktl_invoke_obfuscation_via_stdin.yml
// ID Sigma: 9c14c9fa-1a63-4a64-8e57-d19280559490
// Título: Invoke-Obfuscation Via Stdin
// Descripción: Detects Obfuscated Powershell via Stdin in Scripts
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: high
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_hktl_invoke_obfuscation_via_stdin.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where ProcessCommandLine matches regex "(?i)(?:set).*&&\\s?set.*(?:environment|invoke|\\$\\{?input).*&&.*\""
