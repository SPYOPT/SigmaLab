// Regla Sigma: proc_creation_win_reg_write_protect_for_storage_disabled.yml
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_reg_write_protect_for_storage_disabled.yml
// Pipeline: microsoft_xdr
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where ProcessCommandLine contains "\\System\\CurrentControlSet\\Control" and ProcessCommandLine contains "Write Protection" and ProcessCommandLine contains "0" and ProcessCommandLine contains "storage"
