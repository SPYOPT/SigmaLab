// Regla Sigma: proc_creation_win_susp_download_office_domain.yml
// ID Sigma: 00d49ed5-4491-4271-a8db-650a4ef6f8c1
// Título: Suspicious Download from Office Domain
// Descripción: Detects suspicious ways to download files from Microsoft domains that are used to store attachments in Emails or OneNote documents
// Fecha de creación: 2021-12-27
// Fecha de modificación: 2022-08-02
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: high
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_susp_download_office_domain.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where ((FolderPath endswith "\\curl.exe" or FolderPath endswith "\\wget.exe") or (ProcessCommandLine contains "Invoke-WebRequest" or ProcessCommandLine contains "iwr " or ProcessCommandLine contains "curl " or ProcessCommandLine contains "wget " or ProcessCommandLine contains "Start-BitsTransfer" or ProcessCommandLine contains ".DownloadFile(" or ProcessCommandLine contains ".DownloadString(")) and (ProcessCommandLine contains "https://attachment.outlook.live.net/owa/" or ProcessCommandLine contains "https://onenoteonlinesync.onenote.com/onenoteonlinesync/")
