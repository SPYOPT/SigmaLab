// Regla Sigma: proc_creation_win_reagentc_disable_windows_recovery_environment.yml
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_reagentc_disable_windows_recovery_environment.yml
// Pipeline: microsoft_xdr
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (FolderPath endswith "\\reagentc.exe" or ProcessVersionInfoOriginalFileName =~ "reagentc.exe") and (ProcessCommandLine contains "-disable" or ProcessCommandLine contains "/disable" or ProcessCommandLine contains "–disable" or ProcessCommandLine contains "—disable" or ProcessCommandLine contains "―disable")
