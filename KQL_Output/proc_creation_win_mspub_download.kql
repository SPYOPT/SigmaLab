// Regla Sigma: proc_creation_win_mspub_download.yml
// ID Sigma: 3b3c7f55-f771-4dd6-8a6e-08d057a17caf
// Título: Arbitrary File Download Via MSPUB.EXE
// Descripción: Detects usage of "MSPUB" (Microsoft Publisher) to download arbitrary files
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_mspub_download.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (FolderPath endswith "\\MSPUB.exe" or ProcessVersionInfoOriginalFileName =~ "MSPUB.exe") and (ProcessCommandLine contains "ftp://" or ProcessCommandLine contains "http://" or ProcessCommandLine contains "https://")
