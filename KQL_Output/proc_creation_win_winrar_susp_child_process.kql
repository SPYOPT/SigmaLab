// Regla Sigma: proc_creation_win_winrar_susp_child_process.yml
// ID Sigma: 146aace8-9bd6-42ba-be7a-0070d8027b76
// Título: Potentially Suspicious Child Process Of WinRAR.EXE
// Descripción: Detects potentially suspicious child processes of WinRAR.exe.
// Fecha de creación: 2023-08-31
// Fecha de modificación: 
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_winrar_susp_child_process.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where InitiatingProcessFolderPath endswith "\\WinRAR.exe" and ((FolderPath endswith "\\cmd.exe" or FolderPath endswith "\\cscript.exe" or FolderPath endswith "\\mshta.exe" or FolderPath endswith "\\powershell.exe" or FolderPath endswith "\\pwsh.exe" or FolderPath endswith "\\regsvr32.exe" or FolderPath endswith "\\rundll32.exe" or FolderPath endswith "\\wscript.exe") or (ProcessVersionInfoOriginalFileName in~ ("Cmd.Exe", "cscript.exe", "mshta.exe", "PowerShell.EXE", "pwsh.dll", "regsvr32.exe", "RUNDLL32.EXE", "wscript.exe")))
