// Regla Sigma: proc_creation_win_office_winword_dll_load.yml
// ID Sigma: f7375e28-5c14-432f-b8d1-1db26c832df3
// Título: Potential Arbitrary DLL Load Using Winword
// Descripción: Detects potential DLL sideloading using the Microsoft Office winword process via the '/l' flag.
// Fecha de creación: 2020-10-09
// Fecha de modificación: 2023-03-29
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_office_winword_dll_load.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (FolderPath endswith "\\WINWORD.exe" or ProcessVersionInfoOriginalFileName =~ "WinWord.exe") and (ProcessCommandLine contains "/l " and ProcessCommandLine contains ".dll")
