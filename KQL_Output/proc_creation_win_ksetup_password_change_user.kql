// Regla Sigma: proc_creation_win_ksetup_password_change_user.yml
// ID Sigma: c9783e20-4793-4164-ba96-d9ee483992c4
// Título: Logged-On User Password Change Via Ksetup.EXE
// Descripción: Detects password change for the logged-on user's via "ksetup.exe"
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_ksetup_password_change_user.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (FolderPath endswith "\\ksetup.exe" or ProcessVersionInfoOriginalFileName =~ "ksetup.exe") and ProcessCommandLine contains " /ChangePassword "
