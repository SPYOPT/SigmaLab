// Regla Sigma: proc_creation_win_wusa_cab_files_extraction_from_susp_paths.yml
// ID Sigma: c74c0390-3e20-41fd-a69a-128f0275a5ea
// Título: Cab File Extraction Via Wusa.EXE From Potentially Suspicious Paths
// Descripción: Detects the execution of the "wusa.exe" (Windows Update Standalone Installer) utility to extract ".cab" files using the "/extract" argument from potentially suspicious paths.

// Fecha de creación: 2022-08-05
// Fecha de modificación: 2023-11-28
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: high
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_wusa_cab_files_extraction_from_susp_paths.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (FolderPath endswith "\\wusa.exe" and ProcessCommandLine contains "/extract:") and (ProcessCommandLine contains ":\\PerfLogs\\" or ProcessCommandLine contains ":\\Users\\Public\\" or ProcessCommandLine contains ":\\Windows\\Temp\\" or ProcessCommandLine contains "\\Appdata\\Local\\Temp\\")
