// Regla Sigma: proc_creation_win_pua_advanced_ip_scanner.yml
// ID Sigma: bef37fa2-f205-4a7b-b484-0759bfd5f86f
// Título: PUA - Advanced IP Scanner Execution
// Descripción: Detects the use of Advanced IP Scanner. Seems to be a popular tool for ransomware groups.
// Fecha de creación: 2020-05-12
// Fecha de modificación: 2023-02-07
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_pua_advanced_ip_scanner.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (FolderPath contains "\\advanced_ip_scanner" or ProcessVersionInfoOriginalFileName contains "advanced_ip_scanner" or ProcessVersionInfoFileDescription contains "Advanced IP Scanner") or (ProcessCommandLine contains "/portable" and ProcessCommandLine contains "/lng")
