// Regla Sigma: proc_creation_macos_tail_base64_decode_from_image.yml
// ID Sigma: 09a910bf-f71f-4737-9c40-88880ba5913d
// Título: Potential Base64 Decoded From Images
// Descripción: Detects the use of tail to extract bytes at an offset from an image and then decode the base64 value to create a new file with the decoded content. The detected execution is a bash one-liner.

// Fecha de creación: 2023-12-20
// Fecha de modificación: 
// Aplica a: Producto: macos | Categoría: process_creation
// Producto: macos
// Categoría: process_creation
// Servicio: 
// Nivel: high
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\macos\process_creation\proc_creation_macos_tail_base64_decode_from_image.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where FolderPath endswith "/bash" and (ProcessCommandLine contains "tail" and ProcessCommandLine contains "-c") and (ProcessCommandLine contains "base64" and ProcessCommandLine contains "-d" and ProcessCommandLine contains ">") and (ProcessCommandLine contains ".avif" or ProcessCommandLine contains ".gif" or ProcessCommandLine contains ".jfif" or ProcessCommandLine contains ".jpeg" or ProcessCommandLine contains ".jpg" or ProcessCommandLine contains ".pjp" or ProcessCommandLine contains ".pjpeg" or ProcessCommandLine contains ".png" or ProcessCommandLine contains ".svg" or ProcessCommandLine contains ".webp")
