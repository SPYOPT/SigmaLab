// Regla Sigma: proc_creation_win_reg_internal_tools_setting_tampering.yml
// ID Sigma: ccc946a3-f65a-432a-bb6f-efc6acc1fd27
// Título: Registry Tampering Of Internal Tools Settings
// Descripción: Detects registry modifications that tamper with internal Windows tools settings, commonly used by malware to disable security features or system tools
// Fecha de creación: 2026-10-18
// Fecha de modificación: 
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_reg_internal_tools_setting_tampering.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (FolderPath endswith "\\reg.exe" or ProcessVersionInfoOriginalFileName =~ "reg.exe") and ProcessCommandLine contains " add " and (ProcessCommandLine contains "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\Explorer" or ProcessCommandLine contains "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System" or ProcessCommandLine contains "SOFTWARE\\Policies\\Microsoft\\Windows\\Explorer" or ProcessCommandLine contains "SOFTWARE\\Policies\\Microsoft\\Windows\\System") and (ProcessCommandLine contains "ConsentPromptBehaviorAdmin" or ProcessCommandLine contains "DisableChangePassword" or ProcessCommandLine contains "DisableCMD" or ProcessCommandLine contains "DisableLockWorkstation" or ProcessCommandLine contains "DisableNotificationCenter" or ProcessCommandLine contains "DisableRegistryTools" or ProcessCommandLine contains "DisableTaskmgr" or ProcessCommandLine contains "HideSCAHealth" or ProcessCommandLine contains "HideSCANetwork" or ProcessCommandLine contains "HideSCAVolume" or ProcessCommandLine contains "InactivityTimeoutSecs" or ProcessCommandLine contains "NoClose" or ProcessCommandLine contains "NoControlPanel" or ProcessCommandLine contains "NoDesktop" or ProcessCommandLine contains "NoDispBackgroundPage" or ProcessCommandLine contains "NoDispCPL" or ProcessCommandLine contains "NoDrives" or ProcessCommandLine contains "NoFileMenu" or ProcessCommandLine contains "NoFind" or ProcessCommandLine contains "NoLogOff" or ProcessCommandLine contains "NoPropertiesMyDocuments" or ProcessCommandLine contains "NoRun" or ProcessCommandLine contains "NoSetTaskbar" or ProcessCommandLine contains "NoTrayContextMenu" or ProcessCommandLine contains "StartMenuLogOff" or ProcessCommandLine contains "shutdownwithoutlogon")
