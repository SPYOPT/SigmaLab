// Regla Sigma: proc_creation_win_susp_disable_raccine.yml
// ID Sigma: a31eeaed-3fd5-478e-a8ba-e62c6b3f9ecc
// Título: Raccine Uninstall
// Descripción: Detects commands that indicate a Raccine removal from an end system. Raccine is a free ransomware protection tool.
// Fecha de creación: 2021-01-21
// Fecha de modificación: 2022-10-09
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: high
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_susp_disable_raccine.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (ProcessCommandLine contains "taskkill " and ProcessCommandLine contains "RaccineSettings.exe") or (ProcessCommandLine contains "reg.exe" and ProcessCommandLine contains "delete" and ProcessCommandLine contains "Raccine Tray") or (ProcessCommandLine contains "schtasks" and ProcessCommandLine contains "/DELETE" and ProcessCommandLine contains "Raccine Rules Updater")
