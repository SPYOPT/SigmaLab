// Regla Sigma: proc_creation_lnx_file_deletion.yml
// ID Sigma: 30aed7b6-d2c1-4eaf-9382-b6bc43e50c57
// Título: File Deletion
// Descripción: Detects file deletion using "rm", "shred" or "unlink" commands which are used often by adversaries to delete files left behind by the actions of their intrusion activity
// Aplica a: Producto: linux | Categoría: process_creation
// Producto: linux
// Categoría: process_creation
// Servicio: 
// Nivel: informational
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\linux\process_creation\proc_creation_lnx_file_deletion.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where FolderPath endswith "/rm" or FolderPath endswith "/shred" or FolderPath endswith "/unlink"
