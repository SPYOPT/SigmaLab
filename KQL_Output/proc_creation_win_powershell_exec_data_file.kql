// Regla Sigma: proc_creation_win_powershell_exec_data_file.yml
// ID Sigma: ee218c12-627a-4d27-9e30-d6fb2fe22ed2
// Título: Powershell Inline Execution From A File
// Descripción: Detects inline execution of PowerShell code from a file
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_powershell_exec_data_file.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (ProcessCommandLine contains "iex " or ProcessCommandLine contains "Invoke-Expression " or ProcessCommandLine contains "Invoke-Command " or ProcessCommandLine contains "icm ") and (ProcessCommandLine contains "cat " or ProcessCommandLine contains "get-content " or ProcessCommandLine contains "type ") and ProcessCommandLine contains " -raw"
