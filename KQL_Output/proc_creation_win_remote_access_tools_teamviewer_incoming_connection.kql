// Pipeline: microsoft_xdr
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where FolderPath =~ "TeamViewer_Desktop.exe" and InitiatingProcessFolderPath =~ "TeamViewer_Service.exe" and ProcessCommandLine endswith "TeamViewer_Desktop.exe --IPCport 5939 --Module 1"
