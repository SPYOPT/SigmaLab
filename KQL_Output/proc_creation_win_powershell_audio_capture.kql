// Regla Sigma: proc_creation_win_powershell_audio_capture.yml
// ID Sigma: 932fb0d8-692b-4b0f-a26e-5643a50fe7d6
// Título: Audio Capture via PowerShell
// Descripción: Detects audio capture via PowerShell Cmdlet.
// Fecha de creación: 2019-10-24
// Fecha de modificación: 2023-04-06
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_powershell_audio_capture.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where ProcessCommandLine contains "WindowsAudioDevice-Powershell-Cmdlet" or ProcessCommandLine contains "Toggle-AudioDevice" or ProcessCommandLine contains "Get-AudioDevice " or ProcessCommandLine contains "Set-AudioDevice " or ProcessCommandLine contains "Write-AudioDevice "
