// Regla Sigma: proc_creation_win_whoami_groups_discovery.yml
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_whoami_groups_discovery.yml
// Pipeline: microsoft_xdr
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (FolderPath endswith "\\whoami.exe" or ProcessVersionInfoOriginalFileName =~ "whoami.exe") and (ProcessCommandLine contains " /groups" or ProcessCommandLine contains " -groups")
