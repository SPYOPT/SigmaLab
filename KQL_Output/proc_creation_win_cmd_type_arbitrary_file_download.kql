// Regla Sigma: proc_creation_win_cmd_type_arbitrary_file_download.yml
// ID Sigma: aa0b3a82-eacc-4ec3-9150-b5a9a3e3f82f
// Título: Potential Download/Upload Activity Using Type Command
// Descripción: Detects usage of the "type" command to download/upload data from WebDAV server
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_cmd_type_arbitrary_file_download.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (ProcessCommandLine contains "type " and ProcessCommandLine contains " > \\\\") or (ProcessCommandLine contains "type \\\\" and ProcessCommandLine contains " > ")
