// Regla Sigma: proc_creation_win_bcdedit_susp_execution.yml
// ID Sigma: c9fbe8e9-119d-40a6-9b59-dd58a5d84429
// Título: Potential Ransomware or Unauthorized MBR Tampering Via Bcdedit.EXE
// Descripción: Detects potential malicious and unauthorized usage of bcdedit.exe
// Fecha de creación: 2019-02-07
// Fecha de modificación: 2023-02-15
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_bcdedit_susp_execution.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (FolderPath endswith "\\bcdedit.exe" or ProcessVersionInfoOriginalFileName =~ "bcdedit.exe") and (ProcessCommandLine contains "delete" or ProcessCommandLine contains "deletevalue" or ProcessCommandLine contains "import" or ProcessCommandLine contains "safeboot" or ProcessCommandLine contains "network")
