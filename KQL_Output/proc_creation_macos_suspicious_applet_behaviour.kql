// Regla Sigma: proc_creation_macos_suspicious_applet_behaviour.yml
// Ruta original: C:\SigmaLab\sigma\rules\macos\process_creation\proc_creation_macos_suspicious_applet_behaviour.yml
// Pipeline: microsoft_xdr
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (InitiatingProcessFolderPath endswith "/applet" or InitiatingProcessFolderPath endswith "/osascript") and ProcessCommandLine contains "osacompile"
