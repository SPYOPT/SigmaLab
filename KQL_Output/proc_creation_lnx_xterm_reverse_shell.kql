// Regla Sigma: proc_creation_lnx_xterm_reverse_shell.yml
// ID Sigma: 4e25af4b-246d-44ea-8563-e42aacab006b
// Título: Potential Xterm Reverse Shell
// Descripción: Detects usage of "xterm" as a potential reverse shell tunnel
// Aplica a: Producto: linux | Categoría: process_creation
// Producto: linux
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\linux\process_creation\proc_creation_lnx_xterm_reverse_shell.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where FolderPath contains "xterm" and ProcessCommandLine contains "-display" and ProcessCommandLine endswith ":1"
