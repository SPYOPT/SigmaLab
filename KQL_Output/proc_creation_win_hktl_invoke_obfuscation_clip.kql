// Regla Sigma: proc_creation_win_hktl_invoke_obfuscation_clip.yml
// ID Sigma: b222df08-0e07-11eb-adc1-0242ac120002
// Título: Invoke-Obfuscation CLIP+ Launcher
// Descripción: Detects Obfuscated use of Clip.exe to execute PowerShell
// Fecha de creación: 2020-10-13
// Fecha de modificación: 2022-11-17
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: high
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_hktl_invoke_obfuscation_clip.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (ProcessCommandLine contains "cmd" and ProcessCommandLine contains "&&" and ProcessCommandLine contains "clipboard]::" and ProcessCommandLine contains "-f") and (ProcessCommandLine contains "/c" or ProcessCommandLine contains "/r")
