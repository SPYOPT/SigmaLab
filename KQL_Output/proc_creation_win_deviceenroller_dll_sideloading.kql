// Regla Sigma: proc_creation_win_deviceenroller_dll_sideloading.yml
// ID Sigma: e173ad47-4388-4012-ae62-bd13f71c18a8
// Título: Potential DLL Sideloading Via DeviceEnroller.EXE
// Descripción: Detects the use of the PhoneDeepLink parameter to potentially sideload a DLL file that does not exist. This non-existent DLL file is named "ShellChromeAPI.dll".
Adversaries can drop their own renamed DLL and execute it via DeviceEnroller.exe using this parameter

// Fecha de creación: 2022-08-29
// Fecha de modificación: 2023-02-04
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_deviceenroller_dll_sideloading.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (FolderPath endswith "\\deviceenroller.exe" or ProcessVersionInfoOriginalFileName =~ "deviceenroller.exe") and ProcessCommandLine contains "/PhoneDeepLink"
