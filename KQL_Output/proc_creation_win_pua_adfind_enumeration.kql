// Regla Sigma: proc_creation_win_pua_adfind_enumeration.yml
// ID Sigma: 455b9d50-15a1-4b99-853f-8d37655a4c1b
// Título: PUA - Suspicious ActiveDirectory Enumeration Via AdFind.EXE
// Descripción: Detects active directory enumeration activity using known AdFind CLI flags
// Fecha de creación: 2021-12-13
// Fecha de modificación: 2023-03-05
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: high
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_pua_adfind_enumeration.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (ProcessCommandLine contains "lockoutduration" or ProcessCommandLine contains "lockoutthreshold" or ProcessCommandLine contains "lockoutobservationwindow" or ProcessCommandLine contains "maxpwdage" or ProcessCommandLine contains "minpwdage" or ProcessCommandLine contains "minpwdlength" or ProcessCommandLine contains "pwdhistorylength" or ProcessCommandLine contains "pwdproperties") or ProcessCommandLine contains "-sc admincountdmp" or ProcessCommandLine contains "-sc exchaddresses"
