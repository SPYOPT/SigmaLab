// Regla Sigma: proc_creation_win_psr_capture_screenshots.yml
// ID Sigma: 2158f96f-43c2-43cb-952a-ab4580f32382
// Título: Screen Capture Activity Via Psr.EXE
// Descripción: Detects execution of Windows Problem Steps Recorder (psr.exe), a utility used to record the user screen and clicks.
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_psr_capture_screenshots.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where FolderPath endswith "\\Psr.exe" and (ProcessCommandLine contains "/start" or ProcessCommandLine contains "-start")
