// Regla Sigma: proc_creation_win_schtasks_creation_temp_folder.yml
// ID Sigma: 39019a4e-317f-4ce3-ae63-309a8c6b53c5
// Título: Suspicious Scheduled Task Creation Involving Temp Folder
// Descripción: Detects the creation of scheduled tasks that involves a temporary folder and runs only once
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: high
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_schtasks_creation_temp_folder.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where FolderPath endswith "\\schtasks.exe" and (ProcessCommandLine contains " /create " and ProcessCommandLine contains " /sc once " and ProcessCommandLine contains "\\Temp\\")
