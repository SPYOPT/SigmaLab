// Regla Sigma: proc_creation_win_netsh_fw_enable_group_rule.yml
// ID Sigma: 347906f3-e207-4d18-ae5b-a9403d6bcdef
// Título: Netsh Allow Group Policy on Microsoft Defender Firewall
// Descripción: Adversaries may modify system firewalls in order to bypass controls limiting network usage
// Fecha de creación: 2022-01-09
// Fecha de modificación: 2023-02-14
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_netsh_fw_enable_group_rule.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (FolderPath endswith "\\netsh.exe" or ProcessVersionInfoOriginalFileName =~ "netsh.exe") and (ProcessCommandLine contains "advfirewall" and ProcessCommandLine contains "firewall" and ProcessCommandLine contains "set" and ProcessCommandLine contains "rule" and ProcessCommandLine contains "group=" and ProcessCommandLine contains "new" and ProcessCommandLine contains "enable=Yes")
