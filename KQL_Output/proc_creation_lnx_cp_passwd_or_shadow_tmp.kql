// Regla Sigma: proc_creation_lnx_cp_passwd_or_shadow_tmp.yml
// ID Sigma: fa4aaed5-4fe0-498d-bbc0-08e3346387ba
// Título: Copy Passwd Or Shadow From TMP Path
// Descripción: Detects when the file "passwd" or "shadow" is copied from tmp path
// Fecha de creación: 2023-01-31
// Fecha de modificación: 
// Aplica a: Producto: linux | Categoría: process_creation
// Producto: linux
// Categoría: process_creation
// Servicio: 
// Nivel: high
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\linux\process_creation\proc_creation_lnx_cp_passwd_or_shadow_tmp.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where FolderPath endswith "/cp" and ProcessCommandLine contains "/tmp/" and (ProcessCommandLine contains "passwd" or ProcessCommandLine contains "shadow")
