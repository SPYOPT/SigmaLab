// Regla Sigma: proc_creation_win_hktl_cobaltstrike_load_by_rundll32.yml
// ID Sigma: ae9c6a7c-9521-42a6-915e-5aaa8689d529
// Título: CobaltStrike Load by Rundll32
// Descripción: Rundll32 can be use by Cobalt Strike with StartW function to load DLLs from the command line.
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: high
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_hktl_cobaltstrike_load_by_rundll32.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (FolderPath endswith "\\rundll32.exe" or ProcessVersionInfoOriginalFileName =~ "RUNDLL32.EXE" or (ProcessCommandLine contains "rundll32.exe" or ProcessCommandLine contains "rundll32 ")) and (ProcessCommandLine contains ".dll" and (ProcessCommandLine endswith " StartW" or ProcessCommandLine endswith ",StartW"))
