// Regla Sigma: proc_creation_win_php_inline_command_execution.yml
// ID Sigma: d81871ef-5738-47ab-9797-7a9c90cd4bfb
// Título: Php Inline Command Execution
// Descripción: Detects execution of php using the "-r" flag. This is could be used as a way to launch a reverse shell or execute live php code.
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_php_inline_command_execution.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (FolderPath endswith "\\php.exe" or ProcessVersionInfoOriginalFileName =~ "php.exe") and ProcessCommandLine contains " -r"
