// Regla Sigma: proc_creation_win_mssql_veaam_susp_child_processes.yml
// ID Sigma: d55b793d-f847-4eea-b59a-5ab09908ac90
// Título: Suspicious Child Process Of Veeam Dabatase
// Descripción: Detects suspicious child processes of the Veeam service process. This could indicate potential RCE or SQL Injection.
// Fecha de creación: 2023-05-04
// Fecha de modificación: 
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: critical
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_mssql_veaam_susp_child_processes.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (InitiatingProcessFolderPath endswith "\\sqlservr.exe" and InitiatingProcessCommandLine contains "VEEAMSQL") and (((FolderPath endswith "\\cmd.exe" or FolderPath endswith "\\powershell.exe" or FolderPath endswith "\\pwsh.exe" or FolderPath endswith "\\wsl.exe" or FolderPath endswith "\\wt.exe") and (ProcessCommandLine contains "-ex " or ProcessCommandLine contains "bypass" or ProcessCommandLine contains "cscript" or ProcessCommandLine contains "DownloadString" or ProcessCommandLine contains "http://" or ProcessCommandLine contains "https://" or ProcessCommandLine contains "mshta" or ProcessCommandLine contains "regsvr32" or ProcessCommandLine contains "rundll32" or ProcessCommandLine contains "wscript" or ProcessCommandLine contains "copy ")) or (FolderPath endswith "\\net.exe" or FolderPath endswith "\\net1.exe" or FolderPath endswith "\\netstat.exe" or FolderPath endswith "\\nltest.exe" or FolderPath endswith "\\ping.exe" or FolderPath endswith "\\tasklist.exe" or FolderPath endswith "\\whoami.exe"))
