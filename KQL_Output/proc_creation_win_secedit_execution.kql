// Regla Sigma: proc_creation_win_secedit_execution.yml
// ID Sigma: c2c76b77-32be-4d1f-82c9-7e544bdfe0eb
// Título: Potential Suspicious Activity Using SeCEdit
// Descripción: Detects potential suspicious behaviour using secedit.exe. Such as exporting or modifying the security policy
// Fecha de creación: 2022-11-18
// Fecha de modificación: 2022-12-30
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_secedit_execution.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (FolderPath endswith "\\secedit.exe" or ProcessVersionInfoOriginalFileName =~ "SeCEdit") and ((ProcessCommandLine contains "/export" and ProcessCommandLine contains "/cfg") or (ProcessCommandLine contains "/configure" and ProcessCommandLine contains "/db"))
