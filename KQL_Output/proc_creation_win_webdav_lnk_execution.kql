// Regla Sigma: proc_creation_win_webdav_lnk_execution.yml
// ID Sigma: 1412aa78-a24c-4abd-83df-767dfb2c5bbe
// Título: Potentially Suspicious WebDAV LNK Execution
// Descripción: Detects possible execution via LNK file accessed on a WebDAV server.
// Fecha de creación: 2023-08-21
// Fecha de modificación: 
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_webdav_lnk_execution.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where InitiatingProcessFolderPath endswith "\\explorer.exe" and (FolderPath endswith "\\cmd.exe" or FolderPath endswith "\\cscript.exe" or FolderPath endswith "\\mshta.exe" or FolderPath endswith "\\powershell.exe" or FolderPath endswith "\\pwsh.exe" or FolderPath endswith "\\wscript.exe") and ProcessCommandLine contains "\\DavWWWRoot\\"
