// Regla Sigma: proc_creation_win_vscode_tunnel_remote_shell_.yml
// ID Sigma: f4a623c2-4ef5-4c33-b811-0642f702c9f1
// Título: Visual Studio Code Tunnel Shell Execution
// Descripción: Detects the execution of a shell (powershell, bash, wsl...) via Visual Studio Code tunnel. Attackers can abuse this functionality to establish a C2 channel and execute arbitrary commands on the system.
// Fecha de creación: 2023-10-25
// Fecha de modificación: 
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_vscode_tunnel_remote_shell_.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (InitiatingProcessFolderPath contains "\\servers\\Stable-" and InitiatingProcessFolderPath endswith "\\server\\node.exe" and InitiatingProcessCommandLine contains ".vscode-server") and (((FolderPath endswith "\\powershell.exe" or FolderPath endswith "\\pwsh.exe") and ProcessCommandLine contains "\\terminal\\browser\\media\\shellIntegration.ps1") or (FolderPath endswith "\\wsl.exe" or FolderPath endswith "\\bash.exe"))
