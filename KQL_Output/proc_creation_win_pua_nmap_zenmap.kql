// Regla Sigma: proc_creation_win_pua_nmap_zenmap.yml
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_pua_nmap_zenmap.yml
// Pipeline: microsoft_xdr
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (FolderPath endswith "\\nmap.exe" or FolderPath endswith "\\zennmap.exe") or (ProcessVersionInfoOriginalFileName in~ ("nmap.exe", "zennmap.exe"))
