// Regla Sigma: proc_creation_win_lolbin_scriptrunner.yml
// ID Sigma: 64760eef-87f7-4ed3-93fd-655668ea9420
// Título: Use of Scriptrunner.exe
// Descripción: The "ScriptRunner.exe" binary can be abused to proxy execution through it and bypass possible whitelisting
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_lolbin_scriptrunner.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (FolderPath endswith "\\ScriptRunner.exe" or ProcessVersionInfoOriginalFileName =~ "ScriptRunner.exe") and ProcessCommandLine contains " -appvscript "
