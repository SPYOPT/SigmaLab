// Regla Sigma: proc_creation_win_uninstall_crowdstrike_falcon.yml
// ID Sigma: f0f7be61-9cf5-43be-9836-99d6ef448a18
// Título: Uninstall Crowdstrike Falcon Sensor
// Descripción: Adversaries may disable security tools to avoid possible detection of their tools and activities by uninstalling Crowdstrike Falcon
// Fecha de creación: 2021-07-12
// Fecha de modificación: 2023-03-09
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: high
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_uninstall_crowdstrike_falcon.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where ProcessCommandLine contains "\\WindowsSensor.exe" and ProcessCommandLine contains " /uninstall" and ProcessCommandLine contains " /quiet"
