// Ruta original: C:\SigmaLab\sigma\rules\linux\process_creation\proc_creation_lnx_wget_download_suspicious_directory.yml
// Pipeline: microsoft_xdr
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where FolderPath endswith "/wget" and (ProcessCommandLine matches regex "\\s-O\\s" or ProcessCommandLine contains "--output-document") and ProcessCommandLine contains "/tmp/"
