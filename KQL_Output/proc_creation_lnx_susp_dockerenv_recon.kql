// Regla Sigma: proc_creation_lnx_susp_dockerenv_recon.yml
// ID Sigma: 11701de9-d5a5-44aa-8238-84252f131895
// Título: Docker Container Discovery Via Dockerenv Listing
// Descripción: Detects listing or file reading of ".dockerenv" which can be a sing of potential container discovery
// Aplica a: Producto: linux | Categoría: process_creation
// Producto: linux
// Categoría: process_creation
// Servicio: 
// Nivel: low
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\linux\process_creation\proc_creation_lnx_susp_dockerenv_recon.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (FolderPath endswith "/cat" or FolderPath endswith "/dir" or FolderPath endswith "/find" or FolderPath endswith "/ls" or FolderPath endswith "/stat" or FolderPath endswith "/test" or FolderPath endswith "grep") and ProcessCommandLine endswith ".dockerenv"
