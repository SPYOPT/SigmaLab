// Regla Sigma: proc_creation_win_hktl_empire_powershell_launch.yml
// ID Sigma: 79f4ede3-402e-41c8-bc3e-ebbf5f162581
// Título: HackTool - Empire PowerShell Launch Parameters
// Descripción: Detects suspicious powershell command line parameters used in Empire
// Fecha de creación: 2019-04-20
// Fecha de modificación: 2023-02-21
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: high
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_hktl_empire_powershell_launch.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where ProcessCommandLine contains " -NoP -sta -NonI -W Hidden -Enc " or ProcessCommandLine contains " -noP -sta -w 1 -enc " or ProcessCommandLine contains " -NoP -NonI -W Hidden -enc " or ProcessCommandLine contains " -noP -sta -w 1 -enc" or ProcessCommandLine contains " -enc  SQB" or ProcessCommandLine contains " -nop -exec bypass -EncodedCommand "
