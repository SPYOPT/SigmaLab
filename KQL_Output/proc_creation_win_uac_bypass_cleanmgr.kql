// Regla Sigma: proc_creation_win_uac_bypass_cleanmgr.yml
// ID Sigma: b697e69c-746f-4a86-9f59-7bfff8eab881
// Título: UAC Bypass Using Disk Cleanup
// Descripción: Detects the pattern of UAC Bypass using scheduled tasks and variable expansion of cleanmgr.exe (UACMe 34)
// Fecha de creación: 2021-08-30
// Fecha de modificación: 2024-12-01
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: high
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_uac_bypass_cleanmgr.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where ProcessCommandLine endswith "\"\\system32\\cleanmgr.exe /autoclean /d C:" and InitiatingProcessCommandLine =~ "C:\\Windows\\system32\\svchost.exe -k netsvcs -p -s Schedule" and (ProcessIntegrityLevel in~ ("High", "System", "S-1-16-16384", "S-1-16-12288"))
