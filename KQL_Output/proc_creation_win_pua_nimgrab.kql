// Regla Sigma: proc_creation_win_pua_nimgrab.yml
// ID Sigma: 74a12f18-505c-4114-8d0b-8448dd5485c6
// Título: PUA - Nimgrab Execution
// Descripción: Detects the usage of nimgrab, a tool bundled with the Nim programming framework and used for downloading files.
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: high
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_pua_nimgrab.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where FolderPath endswith "\\nimgrab.exe" or (MD5 startswith "2DD44C3C29D667F5C0EF5F9D7C7FFB8B" or SHA256 startswith "F266609E91985F0FE3E31C5E8FAEEEC4FFA5E0322D8B6F15FE69F4C5165B9559")
