// Regla Sigma: proc_creation_win_hh_chm_remote_download_or_execution.yml
// ID Sigma: f57c58b3-ee69-4ef5-9041-455bf39aaa89
// Título: Remote CHM File Download/Execution Via HH.EXE
// Descripción: Detects the usage of "hh.exe" to execute/download remotely hosted ".chm" files.
// Fecha de creación: 2022-09-29
// Fecha de modificación: 2024-01-31
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: high
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_hh_chm_remote_download_or_execution.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (ProcessVersionInfoOriginalFileName =~ "HH.exe" or FolderPath endswith "\\hh.exe") and (ProcessCommandLine contains "http://" or ProcessCommandLine contains "https://" or ProcessCommandLine contains "\\\\")
