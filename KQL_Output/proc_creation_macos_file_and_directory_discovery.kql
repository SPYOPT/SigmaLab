// Regla Sigma: proc_creation_macos_file_and_directory_discovery.yml
// ID Sigma: 089dbdf6-b960-4bcc-90e3-ffc3480c20f6
// Título: File and Directory Discovery - MacOS
// Descripción: Detects usage of system utilities to discover files and directories
// Aplica a: Producto: macos | Categoría: process_creation
// Producto: macos
// Categoría: process_creation
// Servicio: 
// Nivel: informational
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\macos\process_creation\proc_creation_macos_file_and_directory_discovery.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (FolderPath =~ "/usr/bin/file" and ProcessCommandLine matches regex "(.){200,}") or (FolderPath =~ "/bin/ls" and ProcessCommandLine contains "-R") or FolderPath =~ "/usr/bin/find" or FolderPath =~ "/usr/bin/mdfind" or FolderPath =~ "/tree"
