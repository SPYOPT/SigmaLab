// Regla Sigma: proc_creation_win_wmic_eventconsumer_creation.yml
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_wmic_eventconsumer_creation.yml
// Pipeline: microsoft_xdr
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (ProcessVersionInfoOriginalFileName =~ "wmic.exe" or FolderPath endswith "\\WMIC.exe") and (ProcessCommandLine contains "ActiveScriptEventConsumer" and ProcessCommandLine contains " CREATE ")
