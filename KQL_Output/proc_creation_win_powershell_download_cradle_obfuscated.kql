// Regla Sigma: proc_creation_win_powershell_download_cradle_obfuscated.yml
// ID Sigma: 44e24481-6202-4c62-9127-5a0ae8e3fe3d
// Título: Obfuscated PowerShell OneLiner Execution
// Descripción: Detects the execution of a specific OneLiner to download and execute powershell modules in memory.
// Fecha de creación: 2022-05-09
// Fecha de modificación: 2025-04-16
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: high
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_powershell_download_cradle_obfuscated.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where FolderPath endswith "\\powershell.exe" and (ProcessCommandLine contains "http://127.0.0.1" and ProcessCommandLine contains "%{(IRM $_)}" and ProcessCommandLine contains "Invoke")
