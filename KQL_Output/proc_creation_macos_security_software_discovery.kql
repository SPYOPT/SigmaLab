// Regla Sigma: proc_creation_macos_security_software_discovery.yml
// ID Sigma: 0ed75b9c-c73b-424d-9e7d-496cd565fbe0
// Título: Security Software Discovery - MacOs
// Descripción: Detects usage of system utilities (only grep for now) to discover security software discovery
// Fecha de creación: 2020-10-19
// Fecha de modificación: 2022-11-27
// Aplica a: Producto: macos | Categoría: process_creation
// Producto: macos
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\macos\process_creation\proc_creation_macos_security_software_discovery.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where FolderPath =~ "/usr/bin/grep" and ((ProcessCommandLine contains "nessusd" or ProcessCommandLine contains "santad" or ProcessCommandLine contains "CbDefense" or ProcessCommandLine contains "falcond" or ProcessCommandLine contains "td-agent" or ProcessCommandLine contains "packetbeat" or ProcessCommandLine contains "filebeat" or ProcessCommandLine contains "auditbeat" or ProcessCommandLine contains "osqueryd" or ProcessCommandLine contains "BlockBlock" or ProcessCommandLine contains "LuLu") or (ProcessCommandLine contains "Little" and ProcessCommandLine contains "Snitch"))
