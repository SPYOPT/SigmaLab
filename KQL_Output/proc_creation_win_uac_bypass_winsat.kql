// Regla Sigma: proc_creation_win_uac_bypass_winsat.yml
// ID Sigma: 7a01183d-71a2-46ad-ad5c-acd989ac1793
// Título: UAC Bypass Abusing Winsat Path Parsing - Process
// Descripción: Detects the pattern of UAC Bypass using a path parsing issue in winsat.exe (UACMe 52)
// Fecha de creación: 2021-08-30
// Fecha de modificación: 2024-12-01
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: high
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_uac_bypass_winsat.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (ProcessIntegrityLevel in~ ("High", "System", "S-1-16-16384", "S-1-16-12288")) and InitiatingProcessFolderPath endswith "\\AppData\\Local\\Temp\\system32\\winsat.exe" and InitiatingProcessCommandLine contains "C:\\Windows \\system32\\winsat.exe"
