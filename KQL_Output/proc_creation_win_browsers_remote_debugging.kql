// Regla Sigma: proc_creation_win_browsers_remote_debugging.yml
// ID Sigma: b3d34dc5-2efd-4ae3-845f-8ec14921f449
// Título: Browser Started with Remote Debugging
// Descripción: Detects browsers starting with the remote debugging flags. Which is a technique often used to perform browser injection attacks
// Fecha de creación: 2022-07-27
// Fecha de modificación: 2022-12-23
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_browsers_remote_debugging.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where ProcessCommandLine contains " --remote-debugging-" or (FolderPath endswith "\\firefox.exe" and ProcessCommandLine contains " -start-debugger-server")
