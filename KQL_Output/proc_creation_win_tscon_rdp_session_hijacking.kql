// Regla Sigma: proc_creation_win_tscon_rdp_session_hijacking.yml
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_tscon_rdp_session_hijacking.yml
// Pipeline: microsoft_xdr
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (FolderPath endswith "\\tscon.exe" or ProcessVersionInfoOriginalFileName =~ "tscon.exe") and (ProcessIntegrityLevel in~ ("System", "S-1-16-16384"))
