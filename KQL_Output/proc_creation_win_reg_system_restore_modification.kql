// Regla Sigma: proc_creation_win_reg_system_restore_modification.yml
// ID Sigma: 7c06ab9b-b1d2-4ba9-b06e-09491ded20d9
// Título: System Restore Registry Modification via CommandLine
// Descripción: Detects system restore registry modification via command line, which can be used by adversaries to disable system restore on the computer.

// Fecha de creación: 2026-03-11
// Fecha de modificación: 
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: high
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_reg_system_restore_modification.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where ((FolderPath endswith "\\powershell.exe" or FolderPath endswith "\\pwsh.exe" or FolderPath endswith "\\reg.exe") or (ProcessVersionInfoOriginalFileName in~ ("powershell.exe", "pwsh.dll", "reg.exe"))) and (ProcessCommandLine contains " add " or ProcessCommandLine contains "Set-ItemProperty" or ProcessCommandLine contains "New-ItemProperty") and (ProcessCommandLine contains "\\SOFTWARE\\Policies\\Microsoft\\Windows NT\\SystemRestore" or ProcessCommandLine contains "\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\SystemRestore") and (ProcessCommandLine contains "DisableConfig" or ProcessCommandLine contains "DisableSR")
