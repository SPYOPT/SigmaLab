// Regla Sigma: proc_creation_win_susp_script_interpretor_spawn_credential_scanner.yml
// ID Sigma: 0f60b28c-64dd-4e2c-9a63-5334d3e3a6e6
// Título: Script Interpreter Spawning Credential Scanner - Windows
// Descripción: Detects a script interpreter process (like node.js or bun) spawning a known credential scanning tool (e.g., trufflehog, gitleaks).
This behavior is indicative of an attempt to find and steal secrets, as seen in the "Shai-Hulud: The Second Coming" campaign.

// Fecha de creación: 2025-11-25
// Fecha de modificación: 
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: high
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_susp_script_interpretor_spawn_credential_scanner.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (InitiatingProcessFolderPath endswith "\\node.exe" or InitiatingProcessFolderPath endswith "\\bun.exe") and ((FolderPath endswith "trufflehog.exe" or FolderPath endswith "gitleaks.exe") or (ProcessCommandLine contains "trufflehog" or ProcessCommandLine contains "gitleaks"))
