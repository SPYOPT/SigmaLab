// Regla Sigma: proc_creation_win_browsers_chromium_mockbin_abuse.yml
// ID Sigma: 1c526788-0abe-4713-862f-b520da5e5316
// Título: Chromium Browser Headless Execution To Mockbin Like Site
// Descripción: Detects the execution of a Chromium based browser process with the "headless" flag and a URL pointing to the mockbin.org service (which can be used to exfiltrate data).
// Fecha de creación: 2023-09-11
// Fecha de modificación: 
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: high
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_browsers_chromium_mockbin_abuse.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (FolderPath endswith "\\brave.exe" or FolderPath endswith "\\chrome.exe" or FolderPath endswith "\\msedge.exe" or FolderPath endswith "\\opera.exe" or FolderPath endswith "\\vivaldi.exe") and ProcessCommandLine contains "--headless" and (ProcessCommandLine contains "://run.mocky" or ProcessCommandLine contains "://mockbin")
