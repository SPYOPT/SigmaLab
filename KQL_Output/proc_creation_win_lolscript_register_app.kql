// Regla Sigma: proc_creation_win_lolscript_register_app.yml
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_lolscript_register_app.yml
// Pipeline: microsoft_xdr
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where ((FolderPath endswith "\\cscript.exe" or FolderPath endswith "\\wscript.exe") or (ProcessVersionInfoOriginalFileName in~ ("cscript.exe", "wscript.exe"))) and ProcessCommandLine contains ".vbs -register "
