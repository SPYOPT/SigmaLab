// Regla Sigma: proc_creation_macos_susp_macos_firmware_activity.yml
// ID Sigma: 7ed2c9f7-c59d-4c82-a7e2-f859aa676099
// Título: Suspicious MacOS Firmware Activity
// Descripción: Detects when a user manipulates with Firmward Password on MacOS. NOTE - this command has been disabled on silicon-based apple computers.
// Aplica a: Producto: macos | Categoría: process_creation
// Producto: macos
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\macos\process_creation\proc_creation_macos_susp_macos_firmware_activity.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where FolderPath =~ "/usr/sbin/firmwarepasswd" and (ProcessCommandLine contains "setpasswd" or ProcessCommandLine contains "full" or ProcessCommandLine contains "delete" or ProcessCommandLine contains "check")
