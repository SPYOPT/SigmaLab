// Regla Sigma: proc_creation_win_certmgr_certificate_installation.yml
// ID Sigma: ff992eac-6449-4c60-8c1d-91c9722a1d48
// Título: New Root Certificate Installed Via CertMgr.EXE
// Descripción: Detects execution of "certmgr" with the "add" flag in order to install a new certificate on the system.
Adversaries may install a root certificate on a compromised system to avoid warnings when connecting to adversary controlled web servers.

// Fecha de creación: 2023-03-05
// Fecha de modificación: 
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_certmgr_certificate_installation.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (FolderPath endswith "\\CertMgr.exe" or ProcessVersionInfoOriginalFileName =~ "CERTMGT.EXE") and (ProcessCommandLine contains "/add" and ProcessCommandLine contains "root")
