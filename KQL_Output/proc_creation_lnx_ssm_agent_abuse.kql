// Título: Potential Linux Amazon SSM Agent Hijacking
// Descripción: Detects potential Amazon SSM agent hijack attempts as outlined in the Mitiga research report.
// Aplica a: Producto: linux | Categoría: process_creation
// Producto: linux
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\linux\process_creation\proc_creation_lnx_ssm_agent_abuse.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where FolderPath endswith "/amazon-ssm-agent" and (ProcessCommandLine contains "-register " and ProcessCommandLine contains "-code " and ProcessCommandLine contains "-id " and ProcessCommandLine contains "-region ")
