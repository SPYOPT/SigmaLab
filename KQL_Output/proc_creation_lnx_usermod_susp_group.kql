// Regla Sigma: proc_creation_lnx_usermod_susp_group.yml
// ID Sigma: 6a50f16c-3b7b-42d1-b081-0fdd3ba70a73
// Título: User Added To Root/Sudoers Group Using Usermod
// Descripción: Detects usage of the "usermod" binary to add users add users to the root or suoders groups
// Fecha de creación: 2022-12-21
// Fecha de modificación: 
// Aplica a: Producto: linux | Categoría: process_creation
// Producto: linux
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\linux\process_creation\proc_creation_lnx_usermod_susp_group.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where FolderPath endswith "/usermod" and (ProcessCommandLine contains "-aG root" or ProcessCommandLine contains "-aG sudoers")
