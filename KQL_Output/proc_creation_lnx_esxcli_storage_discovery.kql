// Regla Sigma: proc_creation_lnx_esxcli_storage_discovery.yml
// ID Sigma: f41dada5-3f56-4232-8503-3fb7f9cf2d60
// Título: ESXi Storage Information Discovery Via ESXCLI
// Descripción: Detects execution of the "esxcli" command with the "storage" flag in order to retrieve information about the storage status and other related information. Seen used by malware such as DarkSide and LockBit.
// Aplica a: Producto: linux | Categoría: process_creation
// Producto: linux
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\linux\process_creation\proc_creation_lnx_esxcli_storage_discovery.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (FolderPath endswith "/esxcli" and ProcessCommandLine contains "storage") and (ProcessCommandLine contains " get" or ProcessCommandLine contains " list")
