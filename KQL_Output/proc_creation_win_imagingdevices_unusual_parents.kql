// Regla Sigma: proc_creation_win_imagingdevices_unusual_parents.yml
// ID Sigma: f11f2808-adb4-46c0-802a-8660db50fa99
// Título: ImagingDevices Unusual Parent/Child Processes
// Descripción: Detects unusual parent or children of the ImagingDevices.exe (Windows Contacts) process as seen being used with Bumblebee activity
// Fecha de creación: 2022-09-27
// Fecha de modificación: 2022-12-29
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: high
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_imagingdevices_unusual_parents.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where ((InitiatingProcessFolderPath endswith "\\WmiPrvSE.exe" or InitiatingProcessFolderPath endswith "\\svchost.exe" or InitiatingProcessFolderPath endswith "\\dllhost.exe") and FolderPath endswith "\\ImagingDevices.exe") or InitiatingProcessFolderPath endswith "\\ImagingDevices.exe"
