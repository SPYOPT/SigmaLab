// Regla Sigma: proc_creation_win_winzip_password_compression.yml
// ID Sigma: e2e80da2-8c66-4e00-ae3c-2eebd29f6b6d
// Título: Compress Data and Lock With Password for Exfiltration With WINZIP
// Descripción: An adversary may compress or encrypt data that is collected prior to exfiltration using 3rd party utilities
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_winzip_password_compression.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (ProcessCommandLine contains "winzip.exe" or ProcessCommandLine contains "winzip64.exe") and ProcessCommandLine contains "-s\"" and (ProcessCommandLine contains " -min " or ProcessCommandLine contains " -a ")
