// Regla Sigma: proc_creation_win_remote_access_tools_screenconnect_remote_execution_susp.yml
// ID Sigma: 7b582f1a-b318-4c6a-bf4e-66fe49bf55a5
// Título: Remote Access Tool - ScreenConnect Potential Suspicious Remote Command Execution
// Descripción: Detects potentially suspicious child processes launched via the ScreenConnect client service.

// Fecha de creación: 2022-02-25
// Fecha de modificación: 2024-02-28
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_remote_access_tools_screenconnect_remote_execution_susp.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (InitiatingProcessCommandLine contains ":\\Windows\\TEMP\\ScreenConnect\\" and InitiatingProcessCommandLine contains "run.cmd") and (FolderPath endswith "\\bitsadmin.exe" or FolderPath endswith "\\cmd.exe" or FolderPath endswith "\\curl.exe" or FolderPath endswith "\\dllhost.exe" or FolderPath endswith "\\net.exe" or FolderPath endswith "\\nltest.exe" or FolderPath endswith "\\powershell.exe" or FolderPath endswith "\\pwsh.exe" or FolderPath endswith "\\rundll32.exe" or FolderPath endswith "\\wevtutil.exe")
