// Regla Sigma: proc_creation_lnx_perl_reverse_shell.yml
// ID Sigma: 259df6bc-003f-4306-9f54-4ff1a08fa38e
// Título: Potential Perl Reverse Shell Execution
// Descripción: Detects execution of the perl binary with the "-e" flag and common strings related to potential reverse shell activity
// Aplica a: Producto: linux | Categoría: process_creation
// Producto: linux
// Categoría: process_creation
// Servicio: 
// Nivel: high
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\linux\process_creation\proc_creation_lnx_perl_reverse_shell.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (FolderPath endswith "/perl" and ProcessCommandLine contains " -e ") and ((ProcessCommandLine contains "fdopen(" and ProcessCommandLine contains "::Socket::INET") or (ProcessCommandLine contains "Socket" and ProcessCommandLine contains "connect" and ProcessCommandLine contains "open" and ProcessCommandLine contains "exec"))
