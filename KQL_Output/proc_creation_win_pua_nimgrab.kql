// Regla Sigma: proc_creation_win_pua_nimgrab.yml
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_pua_nimgrab.yml
// Pipeline: microsoft_xdr
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where FolderPath endswith "\\nimgrab.exe" or (MD5 startswith "2DD44C3C29D667F5C0EF5F9D7C7FFB8B" or SHA256 startswith "F266609E91985F0FE3E31C5E8FAEEEC4FFA5E0322D8B6F15FE69F4C5165B9559")
