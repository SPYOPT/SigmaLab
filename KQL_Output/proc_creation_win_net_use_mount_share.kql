// Regla Sigma: proc_creation_win_net_use_mount_share.yml
// ID Sigma: f117933c-980c-4f78-b384-e3d838111165
// Título: Windows Share Mount Via Net.EXE
// Descripción: Detects when a share is mounted using the "net.exe" utility
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: low
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_net_use_mount_share.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where ((FolderPath endswith "\\net.exe" or FolderPath endswith "\\net1.exe") or (ProcessVersionInfoOriginalFileName in~ ("net.exe", "net1.exe"))) and (ProcessCommandLine contains " use " or ProcessCommandLine contains " \\\\")
