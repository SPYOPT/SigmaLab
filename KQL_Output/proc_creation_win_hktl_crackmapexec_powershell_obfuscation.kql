// Regla Sigma: proc_creation_win_hktl_crackmapexec_powershell_obfuscation.yml
// ID Sigma: 6f8b3439-a203-45dc-a88b-abf57ea15ccf
// Título: HackTool - CrackMapExec PowerShell Obfuscation
// Descripción: The CrachMapExec pentesting framework implements a PowerShell obfuscation with some static strings detected by this rule.
// Fecha de creación: 2020-05-22
// Fecha de modificación: 2023-02-21
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: high
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_hktl_crackmapexec_powershell_obfuscation.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where ((FolderPath endswith "\\powershell.exe" or FolderPath endswith "\\pwsh.exe") or (ProcessVersionInfoOriginalFileName in~ ("PowerShell.EXE", "pwsh.dll"))) and ((ProcessCommandLine contains "join" and ProcessCommandLine contains "split") or ProcessCommandLine contains "( $ShellId[1]+$ShellId[13]+'x')" or (ProcessCommandLine contains "( $PSHome[" and ProcessCommandLine contains "]+$PSHOME[" and ProcessCommandLine contains "]+") or ProcessCommandLine contains "( $env:Public[13]+$env:Public[5]+'x')" or (ProcessCommandLine contains "( $env:ComSpec[4," and ProcessCommandLine contains ",25]-Join'')") or ProcessCommandLine contains "[1,3]+'x'-Join'')")
