// Regla Sigma: proc_creation_win_certoc_download.yml
// ID Sigma: 70ad0861-d1fe-491c-a45f-fa48148a300d
// Título: File Download via CertOC.EXE
// Descripción: Detects when a user downloads a file by using CertOC.exe
// Fecha de creación: 2022-05-16
// Fecha de modificación: 2023-10-18
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_certoc_download.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (FolderPath endswith "\\certoc.exe" or ProcessVersionInfoOriginalFileName =~ "CertOC.exe") and (ProcessCommandLine contains "-GetCACAPS" and ProcessCommandLine contains "http")
