// Regla Sigma: proc_creation_win_susp_shadow_copies_creation.yml
// ID Sigma: b17ea6f7-6e90-447e-a799-e6c0a493d6ce
// Título: Shadow Copies Creation Using Operating Systems Utilities
// Descripción: Shadow Copies creation using operating systems utilities, possible credential access
// Fecha de creación: 2019-10-22
// Fecha de modificación: 2022-11-10
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_susp_shadow_copies_creation.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where ((FolderPath endswith "\\powershell.exe" or FolderPath endswith "\\pwsh.exe" or FolderPath endswith "\\wmic.exe" or FolderPath endswith "\\vssadmin.exe") or (ProcessVersionInfoOriginalFileName in~ ("PowerShell.EXE", "pwsh.dll", "wmic.exe", "VSSADMIN.EXE"))) and (ProcessCommandLine contains "shadow" and ProcessCommandLine contains "create")
