// Regla Sigma: proc_creation_win_net_user_add.yml
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_net_user_add.yml
// Pipeline: microsoft_xdr
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where ((FolderPath endswith "\\net.exe" or FolderPath endswith "\\net1.exe") or (ProcessVersionInfoOriginalFileName in~ ("net.exe", "net1.exe"))) and (ProcessCommandLine contains "user" and ProcessCommandLine contains "add")
