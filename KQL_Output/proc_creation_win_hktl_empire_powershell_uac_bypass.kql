// Regla Sigma: proc_creation_win_hktl_empire_powershell_uac_bypass.yml
// ID Sigma: 3268b746-88d8-4cd3-bffc-30077d02c787
// Título: HackTool - Empire PowerShell UAC Bypass
// Descripción: Detects some Empire PowerShell UAC bypass methods
// Fecha de creación: 2019-08-30
// Fecha de modificación: 2023-02-21
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: critical
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_hktl_empire_powershell_uac_bypass.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where ProcessCommandLine contains " -NoP -NonI -w Hidden -c $x=$((gp HKCU:Software\\Microsoft\\Windows Update).Update)" or ProcessCommandLine contains " -NoP -NonI -c $x=$((gp HKCU:Software\\Microsoft\\Windows Update).Update);"
