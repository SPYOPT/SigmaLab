// Regla Sigma: proc_creation_win_hktl_inveigh.yml
// ID Sigma: b99a1518-1ad5-4f65-bc95-1ffff97a8fd0
// Título: HackTool - Inveigh Execution
// Descripción: Detects the use of Inveigh a cross-platform .NET IPv4/IPv6 machine-in-the-middle tool
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: critical
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_hktl_inveigh.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where FolderPath endswith "\\Inveigh.exe" or (ProcessVersionInfoOriginalFileName in~ ("\\Inveigh.exe", "\\Inveigh.dll")) or ProcessVersionInfoFileDescription =~ "Inveigh" or (ProcessCommandLine contains " -SpooferIP" or ProcessCommandLine contains " -ReplyToIPs " or ProcessCommandLine contains " -ReplyToDomains " or ProcessCommandLine contains " -ReplyToMACs " or ProcessCommandLine contains " -SnifferIP")
