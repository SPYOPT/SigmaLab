// Regla Sigma: proc_creation_win_regini_ads.yml
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_regini_ads.yml
// Pipeline: microsoft_xdr
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (FolderPath endswith "\\regini.exe" or ProcessVersionInfoOriginalFileName =~ "REGINI.EXE") and ProcessCommandLine matches regex ":[^ \\\\]"
