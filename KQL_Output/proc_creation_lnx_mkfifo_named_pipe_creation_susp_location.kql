// Regla Sigma: proc_creation_lnx_mkfifo_named_pipe_creation_susp_location.yml
// ID Sigma: 999c3b12-0a8c-40b6-8e13-dd7d62b75c7a
// Título: Potentially Suspicious Named Pipe Created Via Mkfifo
// Descripción: Detects the creation of a new named pipe using the "mkfifo" utility in a potentially suspicious location
// Fecha de creación: 2023-06-16
// Fecha de modificación: 
// Aplica a: Producto: linux | Categoría: process_creation
// Producto: linux
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\linux\process_creation\proc_creation_lnx_mkfifo_named_pipe_creation_susp_location.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where FolderPath endswith "/mkfifo" and ProcessCommandLine contains " /tmp/"
