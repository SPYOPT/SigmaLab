// Regla Sigma: proc_creation_win_python_base64_encoded_execution.yml
// ID Sigma: 50a0aa3d-ab16-4594-a8aa-5145a6e6792b
// Título: Python One-Liners with Base64 Decoding
// Descripción: Detects Python one-liners that use base64 decoding functions in command line executions.
Malicious scripts or attackers often use python one-liners to decode and execute base64-encoded payloads, which is a common technique for obfuscation and evasion.

// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: high
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_python_base64_encoded_execution.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (FolderPath contains "\\python" or ProcessVersionInfoOriginalFileName contains "python") and ((ProcessCommandLine contains "import" and ProcessCommandLine contains "base64" and ProcessCommandLine contains " -c") and (ProcessCommandLine contains ".decode" or ProcessCommandLine contains "b16decode" or ProcessCommandLine contains "b32decode" or ProcessCommandLine contains "b32hexdecode" or ProcessCommandLine contains "b64decode" or ProcessCommandLine contains "b85decode" or ProcessCommandLine contains "z85decode"))
