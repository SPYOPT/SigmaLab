// Regla Sigma: proc_creation_win_powershell_set_service_disabled.yml
// ID Sigma: 62b20d44-1546-4e61-afce-8e175eb9473c
// Título: Service StartupType Change Via PowerShell Set-Service
// Descripción: Detects the use of the PowerShell "Set-Service" cmdlet to change the startup type of a service to "disabled" or "manual"
// Fecha de creación: 2023-03-04
// Fecha de modificación: 
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_powershell_set_service_disabled.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (FolderPath endswith "\\powershell.exe" or ProcessVersionInfoOriginalFileName =~ "PowerShell.EXE") and ((ProcessCommandLine contains "Set-Service" and ProcessCommandLine contains "-StartupType") and (ProcessCommandLine contains "Disabled" or ProcessCommandLine contains "Manual"))
