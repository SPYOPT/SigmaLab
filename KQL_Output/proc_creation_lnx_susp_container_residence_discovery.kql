// Regla Sigma: proc_creation_lnx_susp_container_residence_discovery.yml
// ID Sigma: 746c86fb-ccda-4816-8997-01386263acc4
// Título: Container Residence Discovery Via Proc Virtual FS
// Descripción: Detects potential container discovery via listing of certain kernel features in the "/proc" virtual filesystem
// Aplica a: Producto: linux | Categoría: process_creation
// Producto: linux
// Categoría: process_creation
// Servicio: 
// Nivel: low
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\linux\process_creation\proc_creation_lnx_susp_container_residence_discovery.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (FolderPath endswith "awk" or FolderPath endswith "/cat" or FolderPath endswith "grep" or FolderPath endswith "/head" or FolderPath endswith "/less" or FolderPath endswith "/more" or FolderPath endswith "/nl" or FolderPath endswith "/tail") and (ProcessCommandLine contains "/proc/2/" or (ProcessCommandLine contains "/proc/" and (ProcessCommandLine endswith "/cgroup" or ProcessCommandLine endswith "/sched")))
