// Regla Sigma: proc_creation_win_hktl_sharp_ldap_monitor.yml
// ID Sigma: 9f8fc146-1d1a-4dbf-b8fd-dfae15e08541
// Título: HackTool - SharpLDAPmonitor Execution
// Descripción: Detects execution of the SharpLDAPmonitor. Which can monitor the creation, deletion and changes to LDAP objects.
// Fecha de creación: 2022-12-30
// Fecha de modificación: 2023-02-14
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_hktl_sharp_ldap_monitor.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (FolderPath endswith "\\SharpLDAPmonitor.exe" or ProcessVersionInfoOriginalFileName =~ "SharpLDAPmonitor.exe") or (ProcessCommandLine contains "/user:" and ProcessCommandLine contains "/pass:" and ProcessCommandLine contains "/dcip:")
