// Regla Sigma: proc_creation_win_sqlcmd_veeam_db_recon.yml
// ID Sigma: 696bfb54-227e-4602-ac5b-30d9d2053312
// Título: Veeam Backup Database Suspicious Query
// Descripción: Detects potentially suspicious SQL queries using SQLCmd targeting the Veeam backup databases in order to steal information.
// Fecha de creación: 2023-05-04
// Fecha de modificación: 
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_sqlcmd_veeam_db_recon.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (FolderPath endswith "\\sqlcmd.exe" and (ProcessCommandLine contains "VeeamBackup" and ProcessCommandLine contains "From ")) and (ProcessCommandLine contains "BackupRepositories" or ProcessCommandLine contains "Backups" or ProcessCommandLine contains "Credentials" or ProcessCommandLine contains "HostCreds" or ProcessCommandLine contains "SmbFileShares" or ProcessCommandLine contains "Ssh_creds" or ProcessCommandLine contains "VSphereInfo")
