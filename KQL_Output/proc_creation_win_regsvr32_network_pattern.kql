// Regla Sigma: proc_creation_win_regsvr32_network_pattern.yml
// ID Sigma: 867356ee-9352-41c9-a8f2-1be690d78216
// Título: Potentially Suspicious Regsvr32 HTTP/FTP Pattern
// Descripción: Detects regsvr32 execution to download/install/register new DLLs that are hosted on Web or FTP servers.
// Fecha de creación: 2023-05-24
// Fecha de modificación: 2023-05-26
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_regsvr32_network_pattern.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (FolderPath endswith "\\regsvr32.exe" or ProcessVersionInfoOriginalFileName =~ "REGSVR32.EXE") and (ProcessCommandLine contains " /i" or ProcessCommandLine contains " -i") and (ProcessCommandLine contains "ftp" or ProcessCommandLine contains "http")
