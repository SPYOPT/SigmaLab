// Regla Sigma: proc_creation_win_hktl_gmer.yml
// ID Sigma: 9082ff1f-88ab-4678-a3cc-5bcff99fc74d
// Título: HackTool - GMER Rootkit Detector and Remover Execution
// Descripción: Detects the execution GMER tool based on image and hash fields.
// Fecha de creación: 2022-10-05
// Fecha de modificación: 2024-11-23
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: high
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_hktl_gmer.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where FolderPath endswith "\\gmer.exe" or (MD5 startswith "E9DC058440D321AA17D0600B3CA0AB04" or SHA1 startswith "539C228B6B332F5AA523E5CE358C16647D8BBE57" or SHA256 startswith "E8A3E804A96C716A3E9B69195DB6FFB0D33E2433AF871E4D4E1EAB3097237173")
