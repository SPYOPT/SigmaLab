// Regla Sigma: proc_creation_win_pua_ditsnap.yml
// ID Sigma: d3b70aad-097e-409c-9df2-450f80dc476b
// Título: PUA - DIT Snapshot Viewer
// Descripción: Detects the use of Ditsnap tool, an inspection tool for Active Directory database, ntds.dit.
// Fecha de creación: 2020-07-04
// Fecha de modificación: 2023-02-21
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: high
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_pua_ditsnap.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where FolderPath endswith "\\ditsnap.exe" or ProcessCommandLine contains "ditsnap.exe"
