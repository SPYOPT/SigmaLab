// Regla Sigma: proc_creation_win_uac_bypass_idiagnostic_profile.yml
// ID Sigma: 4cbef972-f347-4170-b62a-8253f6168e6d
// Título: UAC Bypass Using IDiagnostic Profile
// Descripción: Detects the "IDiagnosticProfileUAC" UAC bypass technique
// Fecha de creación: 2022-07-03
// Fecha de modificación: 2024-12-01
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: high
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_uac_bypass_idiagnostic_profile.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where InitiatingProcessFolderPath endswith "\\DllHost.exe" and InitiatingProcessCommandLine contains " /Processid:{12C21EA7-2EB8-4B55-9249-AC243DA8C666}" and (ProcessIntegrityLevel in~ ("High", "System", "S-1-16-16384", "S-1-16-12288"))
