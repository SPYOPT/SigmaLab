// Regla Sigma: proc_creation_win_powershell_active_directory_module_dll_import.yml
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_powershell_active_directory_module_dll_import.yml
// Pipeline: microsoft_xdr
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where ((FolderPath endswith "\\powershell.exe" or FolderPath endswith "\\pwsh.exe") or (ProcessVersionInfoOriginalFileName in~ ("PowerShell.EXE", "pwsh.dll"))) and (ProcessCommandLine contains "Import-Module " or ProcessCommandLine contains "ipmo ") and ProcessCommandLine contains "Microsoft.ActiveDirectory.Management.dll"
