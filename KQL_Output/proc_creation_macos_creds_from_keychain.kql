// Regla Sigma: proc_creation_macos_creds_from_keychain.yml
// Ruta original: C:\SigmaLab\sigma\rules\macos\process_creation\proc_creation_macos_creds_from_keychain.yml
// Pipeline: microsoft_xdr
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (FolderPath =~ "/usr/bin/security" and (ProcessCommandLine contains "find-certificate" or ProcessCommandLine contains " export ")) or (ProcessCommandLine contains " dump-keychain " or ProcessCommandLine contains " login-keychain ")
