// Regla Sigma: proc_creation_win_wmic_service_manipulation.yml
// ID Sigma: 0b7163dc-7eee-4960-af17-c0cd517f92da
// Título: Service Started/Stopped Via Wmic.EXE
// Descripción: Detects usage of wmic to start or stop a service
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_wmic_service_manipulation.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (ProcessVersionInfoOriginalFileName =~ "wmic.exe" or FolderPath endswith "\\WMIC.exe") and ((ProcessCommandLine contains " service " and ProcessCommandLine contains " call ") and (ProcessCommandLine contains "stopservice" or ProcessCommandLine contains "startservice"))
