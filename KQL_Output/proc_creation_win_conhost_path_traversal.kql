// Regla Sigma: proc_creation_win_conhost_path_traversal.yml
// ID Sigma: ee5e119b-1f75-4b34-add8-3be976961e39
// Título: Conhost.exe CommandLine Path Traversal
// Descripción: detects the usage of path traversal in conhost.exe indicating possible command/argument confusion/hijacking
// Fecha de creación: 2022-06-14
// Fecha de modificación: 
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: high
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_conhost_path_traversal.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where InitiatingProcessCommandLine contains "conhost" and ProcessCommandLine contains "/../../"
