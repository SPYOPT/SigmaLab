// Regla Sigma: proc_creation_win_susp_cli_obfuscation_escape_char.yml
// ID Sigma: f0cdd048-82dc-4f7a-8a7a-b87a52b6d0fd
// Título: Potential Commandline Obfuscation Using Escape Characters
// Descripción: Detects potential commandline obfuscation using known escape characters
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_susp_cli_obfuscation_escape_char.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where ProcessCommandLine contains "h^t^t^p" or ProcessCommandLine contains "h\"t\"t\"p"
