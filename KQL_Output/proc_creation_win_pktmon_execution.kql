// Regla Sigma: proc_creation_win_pktmon_execution.yml
// ID Sigma: f956c7c1-0f60-4bc5-b7d7-b39ab3c08908
// Título: PktMon.EXE Execution
// Descripción: Detects execution of PktMon, a tool that captures network packets.
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_pktmon_execution.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where FolderPath endswith "\\pktmon.exe" or ProcessVersionInfoOriginalFileName =~ "PktMon.exe"
