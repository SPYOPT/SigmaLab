// Regla Sigma: proc_creation_win_cdb_arbitrary_command_execution.yml
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_cdb_arbitrary_command_execution.yml
// Pipeline: microsoft_xdr
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (FolderPath endswith "\\cdb.exe" or ProcessVersionInfoOriginalFileName =~ "CDB.Exe") and (ProcessCommandLine contains " -c " or ProcessCommandLine contains " -cf ")
