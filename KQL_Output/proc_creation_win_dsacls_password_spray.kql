// Regla Sigma: proc_creation_win_dsacls_password_spray.yml
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_dsacls_password_spray.yml
// Pipeline: microsoft_xdr
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (FolderPath endswith "\\dsacls.exe" or ProcessVersionInfoOriginalFileName =~ "DSACLS.EXE") and (ProcessCommandLine contains "/user:" and ProcessCommandLine contains "/passwd:")
