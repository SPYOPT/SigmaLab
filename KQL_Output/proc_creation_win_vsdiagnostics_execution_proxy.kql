// Regla Sigma: proc_creation_win_vsdiagnostics_execution_proxy.yml
// ID Sigma: ac1c92b4-ac81-405a-9978-4604d78cc47e
// Título: Potential Binary Proxy Execution Via VSDiagnostics.EXE
// Descripción: Detects execution of "VSDiagnostics.exe" with the "start" command in order to launch and proxy arbitrary binaries.
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_vsdiagnostics_execution_proxy.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (FolderPath endswith "\\VSDiagnostics.exe" or ProcessVersionInfoOriginalFileName =~ "VSDiagnostics.exe") and ProcessCommandLine contains "start" and (ProcessCommandLine contains " /launch:" or ProcessCommandLine contains " -launch:")
