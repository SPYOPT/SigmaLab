// Regla Sigma: proc_creation_win_wmic_uninstall_application.yml
// ID Sigma: b53317a0-8acf-4fd1-8de8-a5401e776b96
// Título: Application Removed Via Wmic.EXE
// Descripción: Detects the removal or uninstallation of an application via "Wmic.EXE".
// Fecha de creación: 2022-01-28
// Fecha de modificación: 2024-07-02
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_wmic_uninstall_application.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (FolderPath endswith "\\WMIC.exe" or ProcessVersionInfoOriginalFileName =~ "wmic.exe") and (ProcessCommandLine contains "call" and ProcessCommandLine contains "uninstall")
