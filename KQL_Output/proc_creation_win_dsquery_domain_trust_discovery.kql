// Regla Sigma: proc_creation_win_dsquery_domain_trust_discovery.yml
// ID Sigma: 3bad990e-4848-4a78-9530-b427d854aac0
// Título: Domain Trust Discovery Via Dsquery
// Descripción: Detects execution of "dsquery.exe" for domain trust discovery
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_dsquery_domain_trust_discovery.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (FolderPath endswith "\\dsquery.exe" or ProcessVersionInfoOriginalFileName =~ "dsquery.exe") and ProcessCommandLine contains "trustedDomain"
