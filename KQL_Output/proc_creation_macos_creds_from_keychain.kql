// Regla Sigma: proc_creation_macos_creds_from_keychain.yml
// ID Sigma: b120b587-a4c2-4b94-875d-99c9807d6955
// Título: Credentials from Password Stores - Keychain
// Descripción: Detects passwords dumps from Keychain
// Fecha de creación: 2020-10-19
// Fecha de modificación: 2021-11-27
// Aplica a: Producto: macos | Categoría: process_creation
// Producto: macos
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\macos\process_creation\proc_creation_macos_creds_from_keychain.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (FolderPath =~ "/usr/bin/security" and (ProcessCommandLine contains "find-certificate" or ProcessCommandLine contains " export ")) or (ProcessCommandLine contains " dump-keychain " or ProcessCommandLine contains " login-keychain ")
