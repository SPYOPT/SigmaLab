// Regla Sigma: proc_creation_win_setspn_spn_enumeration.yml
// ID Sigma: 1eeed653-dbc8-4187-ad0c-eeebb20e6599
// Título: Potential SPN Enumeration Via Setspn.EXE
// Descripción: Detects service principal name (SPN) enumeration used for Kerberoasting
// Fecha de creación: 2018-11-14
// Fecha de modificación: 2023-10-23
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_setspn_spn_enumeration.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (FolderPath endswith "\\setspn.exe" or ProcessVersionInfoOriginalFileName =~ "setspn.exe" or (ProcessVersionInfoFileDescription contains "Query or reset the computer" and ProcessVersionInfoFileDescription contains "SPN attribute")) and (ProcessCommandLine contains " -q " or ProcessCommandLine contains " /q ")
