// Regla Sigma: proc_creation_win_whoami_output.yml
// ID Sigma: c30fb093-1109-4dc8-88a8-b30d11c95a5d
// Título: Whoami.EXE Execution With Output Option
// Descripción: Detects the execution of "whoami.exe" with the "/FO" flag to choose CSV as output format or with redirection options to export the results to a file for later use.
// Fecha de creación: 2023-02-28
// Fecha de modificación: 2023-12-04
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_whoami_output.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where ((FolderPath endswith "\\whoami.exe" or ProcessVersionInfoOriginalFileName =~ "whoami.exe") and (ProcessCommandLine contains " /FO CSV" or ProcessCommandLine contains " -FO CSV")) or ProcessCommandLine matches regex ".*whoami.*>.*"
