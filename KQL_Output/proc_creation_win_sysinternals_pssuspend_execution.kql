// Regla Sigma: proc_creation_win_sysinternals_pssuspend_execution.yml
// ID Sigma: 48bbc537-b652-4b4e-bd1d-281172df448f
// Título: Sysinternals PsSuspend Execution
// Descripción: Detects usage of Sysinternals PsSuspend which can be abused to suspend critical processes
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_sysinternals_pssuspend_execution.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where ProcessVersionInfoOriginalFileName =~ "pssuspend.exe" or (FolderPath endswith "\\pssuspend.exe" or FolderPath endswith "\\pssuspend64.exe" or FolderPath endswith "\\pssuspend64a.exe")
