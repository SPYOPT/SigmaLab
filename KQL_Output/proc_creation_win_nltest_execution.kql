// Regla Sigma: proc_creation_win_nltest_execution.yml
// ID Sigma: 903076ff-f442-475a-b667-4f246bcc203b
// Título: Nltest.EXE Execution
// Descripción: Detects nltest commands that can be used for information discovery
// Fecha de creación: 2023-02-03
// Fecha de modificación: 
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: low
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_nltest_execution.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where FolderPath endswith "\\nltest.exe" or ProcessVersionInfoOriginalFileName =~ "nltestrk.exe"
