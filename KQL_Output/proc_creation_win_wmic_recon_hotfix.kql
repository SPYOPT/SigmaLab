// Regla Sigma: proc_creation_win_wmic_recon_hotfix.yml
// ID Sigma: dfd2fcb7-8bd5-4daa-b132-5adb61d6ad45
// Título: Windows Hotfix Updates Reconnaissance Via Wmic.EXE
// Descripción: Detects the execution of wmic with the "qfe" flag in order to obtain information about installed hotfix updates on the system. This is often used by pentester and attacker enumeration scripts
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_wmic_recon_hotfix.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (ProcessVersionInfoOriginalFileName =~ "wmic.exe" or FolderPath endswith "\\WMIC.exe") and ProcessCommandLine contains " qfe"
