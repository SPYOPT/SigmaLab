// Regla Sigma: proc_creation_win_fltmc_unload_driver_sysmon.yml
// ID Sigma: 4d7cda18-1b12-4e52-b45c-d28653210df8
// Título: Sysmon Driver Unloaded Via Fltmc.EXE
// Descripción: Detects possible Sysmon filter driver unloaded via fltmc.exe
// Fecha de creación: 2019-10-23
// Fecha de modificación: 2023-02-13
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: high
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_fltmc_unload_driver_sysmon.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (FolderPath endswith "\\fltMC.exe" or ProcessVersionInfoOriginalFileName =~ "fltMC.exe") and (ProcessCommandLine contains "unload" and ProcessCommandLine contains "sysmon")
