// Regla Sigma: proc_creation_win_remote_access_tools_anydesk_piped_password_via_cli.yml
// ID Sigma: b1377339-fda6-477a-b455-ac0923f9ec2c
// Título: Remote Access Tool - AnyDesk Piped Password Via CLI
// Descripción: Detects piping the password to an anydesk instance via CMD and the '--set-password' flag.
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_remote_access_tools_anydesk_piped_password_via_cli.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where ProcessCommandLine contains "/c " and ProcessCommandLine contains "echo " and ProcessCommandLine contains ".exe --set-password"
