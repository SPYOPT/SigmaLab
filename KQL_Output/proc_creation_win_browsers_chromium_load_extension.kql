// Regla Sigma: proc_creation_win_browsers_chromium_load_extension.yml
// ID Sigma: 88d6e60c-759d-4ac1-a447-c0f1466c2d21
// Título: Chromium Browser Instance Executed With Custom Extension
// Descripción: Detects a Chromium based browser process with the 'load-extension' flag to start a instance with a custom extension
// Fecha de creación: 2022-06-19
// Fecha de modificación: 2023-11-28
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_browsers_chromium_load_extension.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (FolderPath endswith "\\brave.exe" or FolderPath endswith "\\chrome.exe" or FolderPath endswith "\\msedge.exe" or FolderPath endswith "\\opera.exe" or FolderPath endswith "\\vivaldi.exe") and ProcessCommandLine contains "--load-extension="
