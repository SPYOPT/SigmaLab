// Regla Sigma: proc_creation_win_reg_delete_runmru.yml
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_reg_delete_runmru.yml
// Pipeline: microsoft_xdr
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (FolderPath endswith "\\reg.exe" or ProcessVersionInfoOriginalFileName =~ "reg.exe") and (ProcessCommandLine contains " del" and ProcessCommandLine contains "\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\RunMRU")
