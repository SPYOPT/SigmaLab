// Regla Sigma: proc_creation_win_browsers_tor_execution.yml
// ID Sigma: 62f7c9bf-9135-49b2-8aeb-1e54a6ecc13c
// Título: Tor Client/Browser Execution
// Descripción: Detects the use of Tor or Tor-Browser to connect to onion routing networks
// Fecha de creación: 2022-02-20
// Fecha de modificación: 2025-10-27
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: high
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_browsers_tor_execution.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where ProcessVersionInfoFileDescription =~ "Tor Browser" or ProcessVersionInfoProductName =~ "Tor Browser" or (FolderPath endswith "\\tor.exe" or FolderPath endswith "\\Tor Browser\\Browser\\firefox.exe")
