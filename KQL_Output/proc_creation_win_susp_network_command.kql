// Regla Sigma: proc_creation_win_susp_network_command.yml
// ID Sigma: a29c1813-ab1f-4dde-b489-330b952e91ae
// Título: Suspicious Network Command
// Descripción: Adversaries may look for details about the network configuration and settings of systems they access or through information discovery of remote systems
// Fecha de creación: 2021-12-07
// Fecha de modificación: 2025-10-19
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: low
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_susp_network_command.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where ProcessCommandLine matches regex "ipconfig\\s+/all" or ProcessCommandLine matches regex "netsh\\s+interface show interface" or ProcessCommandLine matches regex "arp\\s+-a" or ProcessCommandLine matches regex "nbtstat\\s+-n" or ProcessCommandLine matches regex "net\\s+config" or ProcessCommandLine matches regex "route\\s+print"
