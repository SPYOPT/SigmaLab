// Regla Sigma: proc_creation_win_node_abuse.yml
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_node_abuse.yml
// Pipeline: microsoft_xdr
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (FolderPath endswith "\\node.exe" and (ProcessCommandLine contains " -e " or ProcessCommandLine contains " --eval ")) and (ProcessCommandLine contains ".exec(" and ProcessCommandLine contains "net.socket" and ProcessCommandLine contains ".connect" and ProcessCommandLine contains "child_process")
