// Regla Sigma: proc_creation_win_gpg4win_encryption.yml
// ID Sigma: 550bbb84-ce5d-4e61-84ad-e590f0024dcd
// Título: File Encryption Using Gpg4win
// Descripción: Detects usage of Gpg4win to encrypt files
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_gpg4win_encryption.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where ((FolderPath endswith "\\gpg.exe" or FolderPath endswith "\\gpg2.exe") or ProcessVersionInfoFileDescription =~ "GnuPG’s OpenPGP tool") and (ProcessCommandLine contains " -c " and ProcessCommandLine contains "passphrase")
