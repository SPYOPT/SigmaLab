// Regla Sigma: proc_creation_win_cdb_arbitrary_command_execution.yml
// ID Sigma: b5c7395f-e501-4a08-94d4-57fe7a9da9d2
// Título: Potential Binary Proxy Execution Via Cdb.EXE
// Descripción: Detects usage of "cdb.exe" to launch arbitrary processes or commands from a debugger script file
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_cdb_arbitrary_command_execution.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (FolderPath endswith "\\cdb.exe" or ProcessVersionInfoOriginalFileName =~ "CDB.Exe") and (ProcessCommandLine contains " -c " or ProcessCommandLine contains " -cf ")
