// Regla Sigma: proc_creation_win_pua_webbrowserpassview.yml
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_pua_webbrowserpassview.yml
// Pipeline: microsoft_xdr
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where ProcessVersionInfoFileDescription =~ "Web Browser Password Viewer" or FolderPath endswith "\\WebBrowserPassView.exe"
