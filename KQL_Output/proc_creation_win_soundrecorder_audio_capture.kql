// Regla Sigma: proc_creation_win_soundrecorder_audio_capture.yml
// ID Sigma: 83865853-59aa-449e-9600-74b9d89a6d6e
// Título: Audio Capture via SoundRecorder
// Descripción: Detect attacker collecting audio via SoundRecorder application.
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_soundrecorder_audio_capture.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where FolderPath endswith "\\SoundRecorder.exe" and ProcessCommandLine contains "/FILE"
