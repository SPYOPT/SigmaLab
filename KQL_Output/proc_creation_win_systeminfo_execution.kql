// Regla Sigma: proc_creation_win_systeminfo_execution.yml
// ID Sigma: 0ef56343-059e-4cb6-adc1-4c3c967c5e46
// Título: Suspicious Execution of Systeminfo
// Descripción: Detects usage of the "systeminfo" command to retrieve information
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: low
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_systeminfo_execution.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where FolderPath endswith "\\systeminfo.exe" or ProcessVersionInfoOriginalFileName =~ "sysinfo.exe"
