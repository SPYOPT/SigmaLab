// Regla Sigma: proc_creation_win_susp_shadow_copies_deletion.yml
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_susp_shadow_copies_deletion.yml
// Pipeline: microsoft_xdr
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (((FolderPath endswith "\\powershell.exe" or FolderPath endswith "\\pwsh.exe" or FolderPath endswith "\\wmic.exe" or FolderPath endswith "\\vssadmin.exe" or FolderPath endswith "\\diskshadow.exe") or (ProcessVersionInfoOriginalFileName in~ ("PowerShell.EXE", "pwsh.dll", "wmic.exe", "VSSADMIN.EXE", "diskshadow.exe"))) and (ProcessCommandLine contains "shadow" and ProcessCommandLine contains "delete")) or ((FolderPath endswith "\\wbadmin.exe" or ProcessVersionInfoOriginalFileName =~ "WBADMIN.EXE") and (ProcessCommandLine contains "delete" and ProcessCommandLine contains "catalog" and ProcessCommandLine contains "quiet")) or ((FolderPath endswith "\\vssadmin.exe" or ProcessVersionInfoOriginalFileName =~ "VSSADMIN.EXE") and ((ProcessCommandLine contains "resize" and ProcessCommandLine contains "shadowstorage") and (ProcessCommandLine contains "unbounded" or ProcessCommandLine contains "/MaxSize=")))
