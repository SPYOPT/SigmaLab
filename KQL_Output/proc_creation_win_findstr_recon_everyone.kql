// Regla Sigma: proc_creation_win_findstr_recon_everyone.yml
// ID Sigma: 47e4bab7-c626-47dc-967b-255608c9a920
// Título: Permission Misconfiguration Reconnaissance Via Findstr.EXE
// Descripción: Detects usage of findstr with the "EVERYONE" or "BUILTIN" keywords.
This was seen being used in combination with "icacls" and other utilities to spot misconfigured files or folders permissions.

// Fecha de creación: 2022-08-12
// Fecha de modificación: 2023-11-11
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_findstr_recon_everyone.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (((FolderPath endswith "\\find.exe" or FolderPath endswith "\\findstr.exe") or (ProcessVersionInfoOriginalFileName in~ ("FIND.EXE", "FINDSTR.EXE"))) and (ProcessCommandLine contains "\"Everyone\"" or ProcessCommandLine contains "'Everyone'" or ProcessCommandLine contains "\"BUILTIN\\\"" or ProcessCommandLine contains "'BUILTIN\\'")) or (ProcessCommandLine contains "icacls " and ProcessCommandLine contains "findstr " and ProcessCommandLine contains "Everyone")
