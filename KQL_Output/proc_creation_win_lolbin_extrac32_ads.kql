// Regla Sigma: proc_creation_win_lolbin_extrac32_ads.yml
// ID Sigma: 4b13db67-0c45-40f1-aba8-66a1a7198a1e
// Título: Suspicious Extrac32 Alternate Data Stream Execution
// Descripción: Extract data from cab file and hide it in an alternate data stream
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_lolbin_extrac32_ads.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (ProcessCommandLine contains "extrac32.exe" and ProcessCommandLine contains ".cab") and ProcessCommandLine matches regex ":[^\\\\]"
