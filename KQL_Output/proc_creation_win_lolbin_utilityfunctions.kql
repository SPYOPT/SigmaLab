// Regla Sigma: proc_creation_win_lolbin_utilityfunctions.yml
// ID Sigma: 0403d67d-6227-4ea8-8145-4e72db7da120
// Título: UtilityFunctions.ps1 Proxy Dll
// Descripción: Detects the use of a Microsoft signed script executing a managed DLL with PowerShell.
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_lolbin_utilityfunctions.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where ProcessCommandLine contains "UtilityFunctions.ps1" or ProcessCommandLine contains "RegSnapin "
