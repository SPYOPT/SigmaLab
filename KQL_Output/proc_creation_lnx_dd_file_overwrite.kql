// Regla Sigma: proc_creation_lnx_dd_file_overwrite.yml
// ID Sigma: 2953194b-e33c-4859-b9e8-05948c167447
// Título: DD File Overwrite
// Descripción: Detects potential overwriting and deletion of a file using DD.
// Aplica a: Producto: linux | Categoría: process_creation
// Producto: linux
// Categoría: process_creation
// Servicio: 
// Nivel: low
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\linux\process_creation\proc_creation_lnx_dd_file_overwrite.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (FolderPath in~ ("/bin/dd", "/usr/bin/dd")) and ProcessCommandLine contains "of=" and (ProcessCommandLine contains "if=/dev/zero" or ProcessCommandLine contains "if=/dev/null")
