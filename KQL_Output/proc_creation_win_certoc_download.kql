// Regla Sigma: proc_creation_win_certoc_download.yml
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_certoc_download.yml
// Pipeline: microsoft_xdr
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (FolderPath endswith "\\certoc.exe" or ProcessVersionInfoOriginalFileName =~ "CertOC.exe") and (ProcessCommandLine contains "-GetCACAPS" and ProcessCommandLine contains "http")
