// Regla Sigma: proc_creation_win_cmd_stdin_redirect.yml
// ID Sigma: 241e802a-b65e-484f-88cd-c2dc10f9206d
// Título: Read Contents From Stdin Via Cmd.EXE
// Descripción: Detect the use of "<" to read and potentially execute a file via cmd.exe
// Fecha de creación: 2023-03-07
// Fecha de modificación: 
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_cmd_stdin_redirect.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (ProcessVersionInfoOriginalFileName =~ "Cmd.Exe" or FolderPath endswith "\\cmd.exe") and ProcessCommandLine contains "<"
