// Regla Sigma: proc_creation_lnx_nice_shell_execution.yml
// ID Sigma: 093d68c7-762a-42f4-9f46-95e79142571a
// Título: Shell Execution via Nice - Linux
// Descripción: Detects the use of the "nice" utility to execute a shell. Such behavior may be associated with privilege escalation, unauthorized command execution, or to break out from restricted environments.

// Aplica a: Producto: linux | Categoría: process_creation
// Producto: linux
// Categoría: process_creation
// Servicio: 
// Nivel: high
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\linux\process_creation\proc_creation_lnx_nice_shell_execution.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where FolderPath endswith "/nice" and (ProcessCommandLine endswith "/bin/bash" or ProcessCommandLine endswith "/bin/dash" or ProcessCommandLine endswith "/bin/fish" or ProcessCommandLine endswith "/bin/sh" or ProcessCommandLine endswith "/bin/zsh")
