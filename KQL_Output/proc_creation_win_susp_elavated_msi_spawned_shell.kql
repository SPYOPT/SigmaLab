// Regla Sigma: proc_creation_win_susp_elavated_msi_spawned_shell.yml
// ID Sigma: 1e53dd56-8d83-4eb4-a43e-b790a05510aa
// Título: Always Install Elevated MSI Spawned Cmd And Powershell
// Descripción: Detects Windows Installer service (msiexec.exe) spawning "cmd" or "powershell"
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_susp_elavated_msi_spawned_shell.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where ((FolderPath endswith "\\cmd.exe" or FolderPath endswith "\\powershell.exe" or FolderPath endswith "\\pwsh.exe") or (ProcessVersionInfoOriginalFileName in~ ("Cmd.Exe", "PowerShell.EXE", "pwsh.dll"))) and ((InitiatingProcessFolderPath contains "\\Windows\\Installer\\" and InitiatingProcessFolderPath contains "msi") and InitiatingProcessFolderPath endswith "tmp")
