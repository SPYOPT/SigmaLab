// Regla Sigma: proc_creation_win_uac_bypass_ieinstal.yml
// ID Sigma: 80fc36aa-945e-4181-89f2-2f907ab6775d
// Título: UAC Bypass Using IEInstal - Process
// Descripción: Detects the pattern of UAC Bypass using IEInstal.exe (UACMe 64)
// Fecha de creación: 2021-08-30
// Fecha de modificación: 2024-12-01
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: high
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_uac_bypass_ieinstal.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (ProcessIntegrityLevel in~ ("High", "System", "S-1-16-16384", "S-1-16-12288")) and InitiatingProcessFolderPath endswith "\\ieinstal.exe" and FolderPath contains "\\AppData\\Local\\Temp\\" and FolderPath endswith "consent.exe"
