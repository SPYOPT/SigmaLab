// Regla Sigma: proc_creation_lnx_mount_hidepid.yml
// ID Sigma: ec52985a-d024-41e3-8ff6-14169039a0b3
// Título: Mount Execution With Hidepid Parameter
// Descripción: Detects execution of the "mount" command with "hidepid" parameter to make invisible processes to other users from the system
// Aplica a: Producto: linux | Categoría: process_creation
// Producto: linux
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\linux\process_creation\proc_creation_lnx_mount_hidepid.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where FolderPath endswith "/mount" and (ProcessCommandLine contains "hidepid=2" and ProcessCommandLine contains " -o ")
