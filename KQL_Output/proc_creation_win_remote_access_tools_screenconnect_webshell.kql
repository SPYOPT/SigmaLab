// Regla Sigma: proc_creation_win_remote_access_tools_screenconnect_webshell.yml
// ID Sigma: b19146a3-25d4-41b4-928b-1e2a92641b1b
// Título: Remote Access Tool - ScreenConnect Server Web Shell Execution
// Descripción: Detects potential web shell execution from the ScreenConnect server process.
// Fecha de creación: 2024-02-26
// Fecha de modificación: 
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: high
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_remote_access_tools_screenconnect_webshell.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where InitiatingProcessFolderPath endswith "\\ScreenConnect.Service.exe" and (FolderPath endswith "\\cmd.exe" or FolderPath endswith "\\csc.exe")
