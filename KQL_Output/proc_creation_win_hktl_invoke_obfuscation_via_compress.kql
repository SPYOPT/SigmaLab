// Regla Sigma: proc_creation_win_hktl_invoke_obfuscation_via_compress.yml
// ID Sigma: 7eedcc9d-9fdb-4d94-9c54-474e8affc0c7
// Título: Invoke-Obfuscation COMPRESS OBFUSCATION
// Descripción: Detects Obfuscated Powershell via COMPRESS OBFUSCATION
// Fecha de creación: 2020-10-18
// Fecha de modificación: 2022-12-29
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_hktl_invoke_obfuscation_via_compress.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (ProcessCommandLine contains "new-object" and ProcessCommandLine contains "text.encoding]::ascii") and (ProcessCommandLine contains "system.io.compression.deflatestream" or ProcessCommandLine contains "system.io.streamreader" or ProcessCommandLine contains "readtoend(")
