// Regla Sigma: proc_creation_win_imewbdld_download.yml
// ID Sigma: 863218bd-c7d0-4c52-80cd-0a96c09f54af
// Título: Arbitrary File Download Via IMEWDBLD.EXE
// Descripción: Detects usage of "IMEWDBLD.exe" to download arbitrary files
// Fecha de creación: 2023-11-09
// Fecha de modificación: 
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: high
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_imewbdld_download.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (FolderPath endswith "\\IMEWDBLD.exe" or ProcessVersionInfoOriginalFileName =~ "imewdbld.exe") and (ProcessCommandLine contains "http://" or ProcessCommandLine contains "https://")
