// Regla Sigma: proc_creation_win_msedge_proxy_download.yml
// ID Sigma: e84d89c4-f544-41ca-a6af-4b92fd38b023
// Título: Arbitrary File Download Via MSEDGE_PROXY.EXE
// Descripción: Detects usage of "msedge_proxy.exe" to download arbitrary files
// Aplica a: Producto: windows | Categoría: process_creation
// Producto: windows
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_msedge_proxy_download.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (FolderPath endswith "\\msedge_proxy.exe" or ProcessVersionInfoOriginalFileName =~ "msedge_proxy.exe") and (ProcessCommandLine contains "http://" or ProcessCommandLine contains "https://")
