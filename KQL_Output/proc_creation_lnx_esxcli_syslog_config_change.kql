// Regla Sigma: proc_creation_lnx_esxcli_syslog_config_change.yml
// ID Sigma: 38eb1dbb-011f-40b1-a126-cf03a0210563
// Título: ESXi Syslog Configuration Change Via ESXCLI
// Descripción: Detects changes to the ESXi syslog configuration via "esxcli"
// Fecha de creación: 2023-09-04
// Fecha de modificación: 
// Aplica a: Producto: linux | Categoría: process_creation
// Producto: linux
// Categoría: process_creation
// Servicio: 
// Nivel: medium
// Pipeline: microsoft_xdr
// Ruta original: C:\SigmaLab\sigma\rules\linux\process_creation\proc_creation_lnx_esxcli_syslog_config_change.yml
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where FolderPath endswith "/esxcli" and (ProcessCommandLine contains "system" and ProcessCommandLine contains "syslog" and ProcessCommandLine contains "config") and ProcessCommandLine contains " set"
