// Regla Sigma: proc_creation_win_certutil_ntlm_coercion.yml
// Ruta original: C:\SigmaLab\sigma\rules\windows\process_creation\proc_creation_win_certutil_ntlm_coercion.yml
// Pipeline: microsoft_xdr
// Requiere validación en el entorno de destino.

DeviceProcessEvents
| where (FolderPath endswith "\\certutil.exe" or ProcessVersionInfoOriginalFileName =~ "CertUtil.exe") and (ProcessCommandLine contains " -syncwithWU " and ProcessCommandLine contains " \\\\")
